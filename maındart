//  QIBLA EKRANI  —  Profesyonel yeniden tasarım
// ─────────────────────────────────────────────
class QiblaScreen extends StatefulWidget {
  const QiblaScreen({super.key});
  @override
  State<QiblaScreen> createState() => _QiblaScreenState();
}

class _QiblaScreenState extends State<QiblaScreen>
    with TickerProviderStateMixin {
  double? _qiblaAngle;
  double _heading = 0;
  double _lat = 0;
  double _lon = 0;
  bool _loading = true;
  String _error = '';
  String _cityName = '';
  StreamSubscription<CompassEvent>? _compassSub;

  // Animasyonlar
  late AnimationController _rotateCtrl;
  late AnimationController _pulseCtrl;
  late Animation<double> _pulseAnim;
  late AnimationController _appearCtrl;
  late Animation<double> _appearAnim;

  double _smoothHeading = 0;
  double _prevHeading = 0;
  Timer? _smoothTimer;

  @override
  void initState() {
    super.initState();

    _rotateCtrl = AnimationController(
        vsync: this, duration: const Duration(milliseconds: 300));

    _pulseCtrl =
        AnimationController(vsync: this, duration: const Duration(seconds: 2));
    _pulseAnim = Tween<double>(begin: 1.0, end: 1.08)
        .animate(CurvedAnimation(parent: _pulseCtrl, curve: Curves.easeInOut));
    _pulseCtrl.repeat(reverse: true);

    _appearCtrl = AnimationController(
        vsync: this, duration: const Duration(milliseconds: 600));
    _appearAnim = CurvedAnimation(parent: _appearCtrl, curve: Curves.easeOut);

    _initQibla();
  }

  Future<void> _initQibla() async {
    if (mounted)
      setState(() {
        _loading = true;
        _error = '';
      });
    try {
      var perm = await Geolocator.checkPermission();
      if (perm == LocationPermission.denied) {
        perm = await Geolocator.requestPermission();
      }
      if (perm == LocationPermission.deniedForever) {
        throw Exception(L.locationPermDenied);
      }

      // Önce son bilinen konumu hızlıca al, sonra doğru konumu al
      Position? lastPos = await Geolocator.getLastKnownPosition();
      if (lastPos != null && mounted) {
        _setPosition(lastPos);
      }

      final pos = await Geolocator.getCurrentPosition(
          locationSettings: const LocationSettings(
              accuracy: LocationAccuracy.medium,
              timeLimit: Duration(seconds: 10)));
      if (mounted) _setPosition(pos);
    } catch (e) {
      if (mounted)
        setState(() {
          _loading = false;
          _error = e.toString();
        });
      return;
    }

    // Pusula başlat
    _compassSub?.cancel();
    _compassSub = FlutterCompass.events?.listen((e) {
      if (!mounted || e.heading == null) return;
      double raw = e.heading!;

      // Smooth geçiş: kısa yol hesabı
      double diff = raw - _prevHeading;
      if (diff > 180) diff -= 360;
      if (diff < -180) diff += 360;
      _smoothHeading = _prevHeading + diff * 0.3;
      _prevHeading = _smoothHeading;

      if (mounted) setState(() => _heading = _smoothHeading);
    });
  }

  void _setPosition(Position pos) {
    final angle = _calcQibla(pos.latitude, pos.longitude);
    setState(() {
      _lat = pos.latitude;
      _lon = pos.longitude;
      _qiblaAngle = angle;
      _loading = false;
    });
    _appearCtrl.forward(from: 0);
    _getCityName(pos.latitude, pos.longitude);
  }

  Future<void> _getCityName(double lat, double lon) async {
    try {
      final marks = await placemarkFromCoordinates(lat, lon);
      if (marks.isNotEmpty && mounted) {
        setState(() => _cityName =
            marks.first.locality ?? marks.first.subAdministrativeArea ?? '');
      }
    } catch (_) {}
  }

  double _calcQibla(double lat, double lon) {
    final dLon = (kKaabaLon - lon) * math.pi / 180;
    final la1 = lat * math.pi / 180;
    final la2 = kKaabaLat * math.pi / 180;
    final y = math.sin(dLon) * math.cos(la2);
    final x = math.cos(la1) * math.sin(la2) -
        math.sin(la1) * math.cos(la2) * math.cos(dLon);
    return (math.atan2(y, x) * 180 / math.pi + 360) % 360;
  }

  double _calcDistance(double lat1, double lon1, double lat2, double lon2) {
    const R = 6371.0;
    final dLat = (lat2 - lat1) * math.pi / 180;
    final dLon = (lon2 - lon1) * math.pi / 180;
    final a = math.sin(dLat / 2) * math.sin(dLat / 2) +
        math.cos(lat1 * math.pi / 180) *
            math.cos(lat2 * math.pi / 180) *
            math.sin(dLon / 2) *
            math.sin(dLon / 2);
    return R * 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a));
  }

  bool get _isAligned {
    if (_qiblaAngle == null) return false;
    double diff = (_qiblaAngle! - _heading).abs() % 360;
    if (diff > 180) diff = 360 - diff;
    return diff < 5;
  }

  @override
  void dispose() {
    _compassSub?.cancel();
    _rotateCtrl.dispose();
    _pulseCtrl.dispose();
    _appearCtrl.dispose();
    _smoothTimer?.cancel();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final bg = isDark ? const Color(0xFF0D1117) : const Color(0xFFF8F5F0);
    final aligned = _isAligned;

    return Scaffold(
      backgroundColor: bg,
      appBar: AppBar(
        title: Text(L.qiblaFinder),
        actions: [
          if (!_loading)
            IconButton(
              icon: const Icon(Icons.refresh_rounded),
              onPressed: () {
                _compassSub?.cancel();
                _initQibla();
              },
            ),
        ],
      ),
      body: _loading
          ? _buildLoadingState(gold)
          : _error.isNotEmpty
              ? _errorCenter(_error, _initQibla)
              : _buildCompassBody(gold, isDark, bg, aligned),
