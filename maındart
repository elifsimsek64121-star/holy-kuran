class HomeWidgetService {
  static const String _iOSPrayer = 'PrayerTimesWidget';
  static const String _androidPrayer = 'PrayerTimesWidgetProvider';

  static Future<void> updatePrayerWidget({
    required String nextPrayer,
    required String nextTime,
    required String cityName,
    required Map<String, String> allTimes,
  }) async {
    try {
      await HomeWidget.saveWidgetData<String>('next_prayer', nextPrayer);
      await HomeWidget.saveWidgetData<String>('next_time', nextTime);
      await HomeWidget.saveWidgetData<String>('city_name', cityName);
      await HomeWidget.saveWidgetData<String>(
          'fajr', allTimes['Fajr'] ?? '--:--');
      await HomeWidget.saveWidgetData<String>(
          'dhuhr', allTimes['Dhuhr'] ?? '--:--');
      await HomeWidget.saveWidgetData<String>(
          'asr', allTimes['Asr'] ?? '--:--');
      await HomeWidget.saveWidgetData<String>(
          'maghrib', allTimes['Maghrib'] ?? '--:--');
      await HomeWidget.saveWidgetData<String>(
          'isha', allTimes['Isha'] ?? '--:--');
      await HomeWidget.updateWidget(
        iOSName: _iOSPrayer,
        androidName: _androidPrayer,
        qualifiedAndroidName: 'com.quranapp.widget.$_androidPrayer',
      );
    } catch (_) {}
  }

  static Future<void> updateVerseWidget({
    required String arabic,
    required String translation,
    required String ref,
  }) async {
    try {
      await HomeWidget.saveWidgetData<String>('verse_arabic', arabic);
      await HomeWidget.saveWidgetData<String>('verse_translation', translation);
      await HomeWidget.saveWidgetData<String>('verse_ref', ref);
      await HomeWidget.updateWidget(
        iOSName: 'DailyVerseWidget',
        androidName: 'DailyVerseWidgetProvider',
      );
    } catch (_) {}
  }
}

