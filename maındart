class _QuranScreenState extends State<QuranScreen>
    with SingleTickerProviderStateMixin {
  late TabController _tab;
  List<SurahMeta> _surahs = [];
  List<SurahMeta> _filtered = [];
  bool _loading = true;
  String _error = '';
  final _search = TextEditingController();
  int? _lastSurah;
  int _lastAyah = 0;

  @override
  void initState() {
    super.initState();
    _tab = TabController(length: 3, vsync: this);
    _search.addListener(() => _filter(_search.text));
    _loadMeta();
    _loadLastPos();
  }

  Future<void> _loadMeta() async {
    try {
      final r = await http
          .get(Uri.parse('https://api.alquran.cloud/v1/meta'))
          .timeout(const Duration(seconds: 15));
      if (r.statusCode == 200) {
        final data = jsonDecode(r.body);
        final refs = (data['data']['surahs']['references'] as List);
        final list = refs
            .map((e) => SurahMeta.fromJson(Map<String, dynamic>.from(e)))
            .toList();
        if (mounted) {
          setState(() {
            _surahs = list;
            _filtered = list;
            _loading = false;
          });
        }
      } else {
        throw Exception('HTTP ${r.statusCode}');
      }
    } catch (e) {
      if (mounted)
        setState(() {
          _loading = false;
          _error = e.toString();
        });
    }
  }

  Future<void> _loadLastPos() async {
    final p = await SharedPreferences.getInstance();
    _lastSurah = p.getInt('last_surah');
    _lastAyah = p.getInt('last_ayah') ?? 0;
    if (mounted) setState(() {});
  }

  void _filter(String q) {
    if (q.isEmpty) {
      setState(() => _filtered = _surahs);
      return;
    }
    final lq = q.toLowerCase();
    setState(() => _filtered = _surahs
        .where((s) =>
            s.englishName.toLowerCase().contains(lq) ||
            s.name.contains(q) ||
            s.number.toString() == q)
        .toList());
  }

  @override
  void dispose() {
    _tab.dispose();
    _search.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    return Scaffold(
      appBar: AppBar(
        title: Text(L.appTitle),
        bottom: TabBar(
          controller: _tab,
          indicatorColor: gold,
          labelColor: gold,
          unselectedLabelColor:
              Theme.of(context).textTheme.bodySmall?.color?.withOpacity(0.5),
          labelStyle: GoogleFonts.tajawal(fontWeight: FontWeight.w700),
          tabs: [
            Tab(text: L.surahList),
            Tab(text: L.mushaf),
            Tab(text: L.audio),
          ],
        ),
      ),
      body: TabBarView(
        controller: _tab,
        children: [
          _buildSurahListTab(),
          MushafTab(reciter: widget.reciter),
          AudioTab(surahs: _surahs),
        ],
      ),
    );
  }

  Widget _buildSurahListTab() {
    if (_loading) return _loadingCenter();
    if (_error.isNotEmpty) {
      return _errorCenter(_error, _loadMeta);
    }
    final gold = Theme.of(context).colorScheme.primary;
    return Column(
      children: [
        Padding(
          padding: const EdgeInsets.all(12),
          child: TextField(
            controller: _search,
            decoration: InputDecoration(
              hintText: L.searchSurah,
              prefixIcon: const Icon(Icons.search, size: 20),
              filled: true,
              contentPadding:
                  const EdgeInsets.symmetric(vertical: 10, horizontal: 14),
              border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                  borderSide: BorderSide.none),
            ),
          ),
        ),
        if (_lastSurah != null && _lastAyah > 0)
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
            child: InkWell(
              onTap: () {
                final s = _surahs.firstWhere((x) => x.number == _lastSurah!,
                    orElse: () => _surahs.first);
                Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (_) => SurahDetailScreen(
                      surah: s,
                      reciter: widget.reciter,
                      translation: widget.translation,
                      scrollToAyah: _lastAyah,
                    ),
                  ),
                ).then((_) => _loadLastPos());
              },
              borderRadius: BorderRadius.circular(10),
              child: Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
                decoration: BoxDecoration(
                  color: gold.withOpacity(0.1),
                  borderRadius: BorderRadius.circular(10),
                  border: Border.all(color: gold.withOpacity(0.3)),
                ),
                child: Row(
                  children: [
                    Icon(Icons.bookmark, color: gold, size: 18),
