class MushafTab extends StatefulWidget {
  final String reciter;
  const MushafTab({super.key, required this.reciter});

  @override
  State<MushafTab> createState() => _MushafTabState();
}

class _MushafTabState extends State<MushafTab> {
  int _page = 1;
  static const int _totalPages = 604;
  List<Map<String, dynamic>> _verses = [];
  bool _loading = false;
  String _error = '';
  final _scrollCtrl = ScrollController();
  final _player = AudioPlayer();
  int _playingIdx = -1;
  bool _isPlaying = false;
  double _fontSize = 22.0;

  @override
  void initState() {
    super.initState();
    _loadPage(_page);
    _player.playerStateStream.listen((s) {
      if (mounted) setState(() => _isPlaying = s.playing);
    });
    _player.processingStateStream.listen((ps) {
      if (ps == ProcessingState.completed) {
        final next = _playingIdx + 1;
        if (next < _verses.length) _playVerse(next);
      }
    });
  }

  // quran.com API v4 — mushaf_id=3 = Medina Mushaf
  Future<void> _loadPage(int page) async {
    if (mounted)
      setState(() {
        _loading = true;
        _error = '';
        _verses = [];
      });
    try {
      final url =
          'https://api.quran.com/api/v4/verses/by_page/$page?mushaf_id=3&fields=text_uthmani,verse_key,juz_number&per_page=50';
      final r =
          await http.get(Uri.parse(url)).timeout(const Duration(seconds: 20));
      if (r.statusCode != 200) throw Exception('HTTP ${r.statusCode}');
      final data = jsonDecode(r.body);
      final vs = data['verses'] as List;
      if (mounted) {
        setState(() {
          _verses = vs
              .map((v) => {
                    'text': v['text_uthmani'] as String? ?? '',
                    'key': v['verse_key'] as String? ?? '',
                    'juz': v['juz_number'],
                  })
              .toList();
          _loading = false;
          _page = page;
          _playingIdx = -1;
        });
        _scrollCtrl.jumpTo(0);
      }
    } catch (e) {
      if (mounted)
        setState(() {
          _loading = false;
          _error = e.toString();
        });
    }
  }

  Future<void> _playVerse(int idx) async {
    if (idx < 0 || idx >= _verses.length) return;
    if (_playingIdx == idx && _isPlaying) {
      await _player.pause();
      return;
    }
    setState(() => _playingIdx = idx);
    try {
      final key = _verses[idx]['key'] as String;
      final parts = key.split(':');
      final s = int.parse(parts[0]);
      final a = int.parse(parts[1]);
      await _player.setUrl(ayahAudioUrl(s, a));
      await _player.play();
    } catch (_) {}
  }

  @override
  void dispose() {
    _player.dispose();
    _scrollCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final isDark = Theme.of(context).brightness == Brightness.dark;

    return Column(
      children: [
        // Page nav bar
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
          color: isDark ? const Color(0xFF161B22) : const Color(0xFFF5F1EB),
          child: Row(
            children: [
              IconButton(
                onPressed: _page > 1 ? () => _loadPage(_page - 1) : null,
                icon: const Icon(Icons.chevron_left),
                visualDensity: VisualDensity.compact,
              ),
              Expanded(
                child: Column(
                  children: [
                    SliderTheme(
                      data: SliderTheme.of(context).copyWith(
                        trackHeight: 3,
                        thumbShape:
                            const RoundSliderThumbShape(enabledThumbRadius: 7),
                        activeTrackColor: gold,
                        thumbColor: gold,
                        inactiveTrackColor: gold.withOpacity(0.2),
                        overlayShape: SliderComponentShape.noOverlay,
                      ),
                      child: Slider(
                        value: _page.toDouble(),
                        min: 1,
                        max: _totalPages.toDouble(),
                        onChangeEnd: (v) => _loadPage(v.round()),
                        onChanged: (v) => setState(() => _page = v.round()),
                      ),
                    ),
                    Text(
                      '${L.mushaf} $_page / $_totalPages',
                      style: TextStyle(
                          fontSize: 11,
                          color: isDark ? Colors.white54 : Colors.black45),
                    ),
                  ],
                ),
              ),
              IconButton(
                onPressed:
                    _page < _totalPages ? () => _loadPage(_page + 1) : null,
                icon: const Icon(Icons.chevron_right),
                visualDensity: VisualDensity.compact,
              ),
              PopupMenuButton<int>(
                icon: const Icon(Icons.more_vert, size: 20),
                onSelected: _loadPage,
                itemBuilder: (_) => [
                  PopupMenuItem(
                    child: _PageJumpWidget(
                        current: _page, total: _totalPages, onJump: _loadPage),
                    value: null,
                  ),
                ],
              ),
            ],
          ),
        ),
        // Content
        Expanded(
          child: _loading
              ? _loadingCenter()
              : _error.isNotEmpty
                  ? _errorCenter(_error, () => _loadPage(_page))
                  : Stack(
                      children: [
                        SingleChildScrollView(
                          controller: _scrollCtrl,
                          padding: const EdgeInsets.fromLTRB(16, 12, 16, 80),
                          child: Column(
                            children: [
                              // Bismillah (if not surah 9 start and not page 1's fatiha)
                              if (_verses.isNotEmpty &&
                                  _verses.first['key']
                                      .toString()
                                      .endsWith(':1') &&
                                  !_verses.first['key']
                                      .toString()
                                      .startsWith('9:'))
                                Padding(
                                  padding: const EdgeInsets.only(bottom: 12),
                                  child: Text(
                                    'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ',
                                    style: GoogleFonts.notoNaskhArabic(
                                        fontSize: 20, color: gold),
                                    textDirection: TextDirection.rtl,
                                    textAlign: TextAlign.center,
                                  ),
                                ),
                              // All verses in one justified block (authentic mushaf style)
                              RichText(
                                textDirection: TextDirection.rtl,
                                textAlign: TextAlign.justify,
                                text: TextSpan(
                                  children:
                                      _verses.asMap().entries.map((entry) {
                                    final i = entry.key;
                                    final v = entry.value;
                                    final key = v['key'] as String;
                                    final ayahNum =
                                        int.tryParse(key.split(':').last) ?? 0;
                                    final isActive = _playingIdx == i;
                                    return TextSpan(children: [
                                      TextSpan(
                                        text: '${v['text']} ',
                                        style: GoogleFonts.notoNaskhArabic(
                                          fontSize: _fontSize,
                                          height: 2.2,
                                          color: isActive
                                              ? Theme.of(context)
                                                  .colorScheme
                                                  .secondary
                                              : (isDark
                                                  ? const Color(0xFFE8D5A3)
                                                  : const Color(0xFF2C1A00)),
                                        ),
                                      ),
                                      WidgetSpan(
                                        alignment: PlaceholderAlignment.middle,
                                        child: GestureDetector(
                                          onTap: () => _playVerse(i),
                                          child: Container(
                                            width: 28,
                                            height: 28,
                                            margin: const EdgeInsets.symmetric(
                                                horizontal: 3),
                                            decoration: BoxDecoration(
                                              shape: BoxShape.circle,
                                              color: isActive
                                                  ? Theme.of(context)
                                                      .colorScheme
                                                      .secondary
                                                      .withOpacity(0.2)
                                                  : gold.withOpacity(0.12),
                                              border: Border.all(
                                                  color: isActive
                                                      ? Theme.of(context)
                                                          .colorScheme
                                                          .secondary
                                                      : gold.withOpacity(0.4)),
                                            ),
                                            child: Center(
                                              child: Text(
                                                '$ayahNum',
                                                style: TextStyle(
                                                    fontSize: 9,
                                                    color: isActive
                                                        ? Theme.of(context)
                                                            .colorScheme
                                                            .secondary
                                                        : gold,
                                                    fontWeight:
                                                        FontWeight.w700),
                                              ),
                                            ),
                                          ),
                                        ),
                                      ),
                                    ]);
                                  }).toList(),
                                ),
                              ),
                            ],
                          ),
                        ),
                        // Font size controls
                        Positioned(
                          bottom: 12,
                          right: 12,
                          child: Column(
                            children: [
                              _FloatBtn(
                                icon: Icons.add,
                                onTap: () => setState(() =>
                                    _fontSize = (_fontSize + 2).clamp(14, 40)),
                              ),
                              const SizedBox(height: 6),
                              _FloatBtn(
                                icon: Icons.remove,
                                onTap: () => setState(() =>
                                    _fontSize = (_fontSize - 2).clamp(14, 40)),
                              ),
                            ],
                          ),
                        ),
                        // Active verse player bar
                        if (_playingIdx >= 0)
                          Positioned(
                            bottom: 0,
                            left: 0,
                            right: 0,
                            child: Container(
                              height: 48,
                              color: isDark
                                  ? const Color(0xFF161B22).withOpacity(0.95)
                                  : Colors.white.withOpacity(0.95),
                              padding:
                                  const EdgeInsets.symmetric(horizontal: 16),
                              child: Row(
                                children: [
                                  Icon(Icons.music_note, color: gold, size: 16),
                                  const SizedBox(width: 8),
                                  Expanded(
                                      child: Text(
                                    _verses[_playingIdx]['key'],
                                    style: TextStyle(
                                        color: gold,
                                        fontSize: 13,
                                        fontWeight: FontWeight.w600),
                                  )),
                                  IconButton(
                                    icon: Icon(
                                        _isPlaying
                                            ? Icons.pause
                                            : Icons.play_arrow,
                                        color: gold,
                                        size: 24),
                                    onPressed: () => _playVerse(_playingIdx),
                                  ),
                                  IconButton(
                                    icon: const Icon(Icons.close, size: 20),
                                    onPressed: () {
                                      _player.stop();
                                      setState(() => _playingIdx = -1);
                                    },
                                  )
                                ],
                              ),
                            ),
                          ),
                      ],
                    ),
        ),
      ],
    );
  }
}

