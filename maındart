// Extension
extension IterableExt<T> on Iterable<T> {
  T? elementAtOrNull(int index) {
    if (index < 0) return null;
    int i = 0;
    for (final e in this) {
      if (i == index) return e;
      i++;
    }
    return null;
  }
}
