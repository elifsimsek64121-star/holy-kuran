class JuzDetailScreen extends StatefulWidget {
  final int juzNumber;
  final SurahMeta startSurah;
  final int startAyah;
  final String reciter;
  final String translation;
  final List<SurahMeta> surahs;
  const JuzDetailScreen(
      {super.key,
      required this.juzNumber,
      required this.startSurah,
      required this.startAyah,
      required this.reciter,
      required this.translation,
      required this.surahs});
  @override
  State<JuzDetailScreen> createState() => _JuzDetailScreenState();
}

class _JuzDetailScreenState extends State<JuzDetailScreen> {
  List<Map<String, dynamic>> _verses = [];
  bool _loading = true;
  String _error = '';
  final _player = AudioPlayer();
  int _playingIdx = -1;
  bool _isPlaying = false;
  double _fontSize = 24;
  final _scrollCtrl = ScrollController();

  @override
  void initState() {
    super.initState();
    _fetchJuz();
    _player.playerStateStream.listen((s) {
      if (mounted) setState(() => _isPlaying = s.playing);
    });
    _player.processingStateStream.listen((ps) {
      if (ps == ProcessingState.completed) {
        final next = _playingIdx + 1;
        if (next < _verses.length) _playVerse(next);
      }
    });
  }

  Future<void> _fetchJuz() async {
    if (mounted)
      setState(() {
        _loading = true;
        _error = '';
      });
    try {
      final r = await http
          .get(Uri.parse(
              'https://api.alquran.cloud/v1/juz/${widget.juzNumber}/quran-uthmani'))
          .timeout(const Duration(seconds: 25));
      if (r.statusCode != 200) throw Exception('HTTP ${r.statusCode}');
      final data = (jsonDecode(r.body) as Map<String, dynamic>)['data']
          as Map<String, dynamic>;
      final ayahs = data['ayahs'] as List;
      List<dynamic> transAyahs = [];
      try {
        final tr2 = await http
            .get(Uri.parse(
                'https://api.alquran.cloud/v1/juz/${widget.juzNumber}/${widget.translation}'))
            .timeout(const Duration(seconds: 20));
        if (tr2.statusCode == 200)
          transAyahs = ((jsonDecode(tr2.body) as Map<String, dynamic>)['data']
              as Map<String, dynamic>)['ayahs'] as List;
      } catch (_) {}
      final verses = <Map<String, dynamic>>[];
      for (int i = 0; i < ayahs.length; i++) {
        final a = ayahs[i] as Map<String, dynamic>;
        final surahN = a['surah']?['number'] as int? ?? 0;
        String meaning = '';
        if (i < transAyahs.length)
          meaning =
              ((transAyahs[i] as Map<String, dynamic>)['text'] as String? ?? '')
                  .replaceAll(RegExp(r'^\d+\.\s*'), '');
        verses.add({
          'arabic': a['text'] as String? ?? '',
          'translation': meaning,
          'surahNumber': surahN,
          'surahName': a['surah']?['name'] as String? ?? '',
          'surahEnName': a['surah']?['englishName'] as String? ?? '',
          'ayahNum': a['numberInSurah'] as int? ?? 0,
          'globalNum': a['number'] as int? ?? 0
        });
      }
      if (mounted)
        setState(() {
          _verses = verses;
          _loading = false;
        });
    } catch (e) {
      if (mounted)
        setState(() {
          _loading = false;
          _error = e.toString();
        });
    }
  }

  Future<void> _playVerse(int idx) async {
    if (idx < 0 || idx >= _verses.length) return;
    if (_playingIdx == idx && _isPlaying) {
      await _player.pause();
      return;
    }
    setState(() => _playingIdx = idx);
    try {
      await _player.setUrl(ayahAudioUrl(
          _verses[idx]['surahNumber'] as int, _verses[idx]['ayahNum'] as int));
      await _player.play();
    } catch (_) {}
  }

  @override
  void dispose() {
    _player.dispose();
    _scrollCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return Scaffold(
      appBar: AppBar(
        title: Text('${L.juz} ${widget.juzNumber}'),
        actions: [
          IconButton(
              icon: const Icon(Icons.text_increase, size: 20),
              onPressed: () => setState(
                  () => _fontSize = (_fontSize + 2).clamp(16, 36).toDouble())),
          IconButton(
              icon: const Icon(Icons.text_decrease, size: 20),
              onPressed: () => setState(
                  () => _fontSize = (_fontSize - 2).clamp(16, 36).toDouble())),
        ],
      ),
      body: _loading
          ? _loadingCenter()
          : _error.isNotEmpty
              ? _errorCenter(_error, _fetchJuz)
              : Column(children: [
                  Container(
                    padding: const EdgeInsets.symmetric(
                        horizontal: 20, vertical: 10),
                    color: isDark
                        ? const Color(0xFF161B22)
                        : const Color(0xFFFAF7F0),
                    child: Row(children: [
                      Container(
                          width: 44,
                          height: 44,
                          decoration: BoxDecoration(
                              shape: BoxShape.circle,
                              gradient: LinearGradient(
                                  colors: [gold, gold.withOpacity(0.6)])),
                          child: Center(
                              child: Text('${widget.juzNumber}',
                                  style: const TextStyle(
                                      fontSize: 18,
                                      fontWeight: FontWeight.w800,
                                      color: Color(0xFF0D1117))))),
                      const SizedBox(width: 12),
                      Expanded(
                          child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                            Text(
                                '${L.juz} ${widget.juzNumber}  •  ${_verses.length} ${L.verses}',
                                style: TextStyle(
                                    fontSize: 13,
                                    fontWeight: FontWeight.w600,
                                    color: gold)),
                            Text(
                                '${widget.startSurah.englishName} ${widget.startAyah}\'den başlıyor',
                                style: TextStyle(
                                    fontSize: 11,
                                    color: isDark
                                        ? Colors.white38
                                        : Colors.black38)),
                          ])),
                      Text(kJuzData[widget.juzNumber - 1]['name'] as String,
                          style: GoogleFonts.notoNaskhArabic(
                              fontSize: 20, color: gold),
                          textDirection: TextDirection.rtl),
                    ]),
                  ),
                  Expanded(
                    child: ListView.builder(
                      controller: _scrollCtrl,
                      padding: const EdgeInsets.fromLTRB(12, 8, 12, 100),
                      itemCount: _verses.length,
                      itemBuilder: (ctx, i) {
                        final v = _verses[i];
                        final isFirstSurah = i == 0 ||
                            _verses[i - 1]['surahNumber'] != v['surahNumber'];
                        return Column(
                            crossAxisAlignment: CrossAxisAlignment.stretch,
                            children: [
                              if (isFirstSurah)
                                Container(
                                  margin:
                                      const EdgeInsets.symmetric(vertical: 8),
                                  padding: const EdgeInsets.symmetric(
                                      vertical: 10, horizontal: 16),
                                  decoration: BoxDecoration(
                                    gradient: LinearGradient(
                                        colors: isDark
                                            ? [
                                                const Color(0xFF1A2332),
                                                const Color(0xFF0D1117)
                                              ]
                                            : [
                                                const Color(0xFFFAF3E0),
                                                const Color(0xFFEDE3D0)
                                              ]),
                                    borderRadius: BorderRadius.circular(12),
                                    border: Border.all(
                                        color: gold.withOpacity(0.3)),
                                  ),
                                  child: Column(children: [
                                    Text(v['surahName'] as String,
                                        style: GoogleFonts.notoNaskhArabic(
                                            fontSize: 22, color: gold),
                                        textDirection: TextDirection.rtl),
                                    Text(v['surahEnName'] as String,
                                        style: TextStyle(
                                            fontSize: 12,
                                            color: isDark
                                                ? Colors.white54
                                                : Colors.black54)),
                                  ]),
                                ),
                              Card(
                                margin: const EdgeInsets.only(bottom: 6),
                                child: Padding(
                                  padding: const EdgeInsets.all(14),
                                  child: Column(
                                      crossAxisAlignment:
                                          CrossAxisAlignment.stretch,
                                      children: [
                                        Row(children: [
                                          Container(
                                              width: 28,
                                              height: 28,
                                              decoration: BoxDecoration(
                                                  shape: BoxShape.circle,
                                                  border: Border.all(
                                                      color: gold
                                                          .withOpacity(0.4)),
                                                  color:
                                                      gold.withOpacity(0.08)),
                                              child: Center(
                                                  child: Text('${v['ayahNum']}',
                                                      style: TextStyle(
                                                          fontSize: 10,
                                                          color: gold,
                                                          fontWeight: FontWeight
                                                              .w700)))),
                                          const Spacer(),
                                          IconButton(
                                              icon: Icon(
                                                  _playingIdx == i && _isPlaying
                                                      ? Icons.pause
                                                      : Icons.play_arrow,
                                                  color: gold,
                                                  size: 22),
                                              onPressed: () => _playVerse(i),
                                              padding: EdgeInsets.zero,
                                              constraints:
                                                  const BoxConstraints()),
                                        ]),
                                        const SizedBox(height: 10),
                                        Text(v['arabic'] as String,
                                            style: GoogleFonts.notoNaskhArabic(
                                                fontSize: _fontSize,
                                                height: 1.8),
