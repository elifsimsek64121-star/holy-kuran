class _HomeScreenState extends State<HomeScreen> {
  Map<String, String> _timings = {};
  String? _nextPrayer;
  Duration? _timeUntilNext;
  String _cityName = '';
  bool _loadingPrayer = true;
  Timer? _timer;
  Map<String, bool> _todayStatus = {};

  int get _verseIdx {
    final now = DateTime.now();
    return (now.day + now.month) % kDailyVerses.length;
  }

  int get _hadithIdx {
    final now = DateTime.now();
    return (now.day + now.month + 1) % kHadiths.length;
  }

  @override
  void initState() {
    super.initState();
    _fetchPrayerTimes();
    _loadTodayStatus();
    _startTimer();
  }

  void _startTimer() {
    _timer = Timer.periodic(const Duration(seconds: 1), (_) {
      if (_timings.isNotEmpty && mounted) {
        setState(() {
          _nextPrayer = PrayerTimesService().getNextPrayer(_timings);
          _timeUntilNext = PrayerTimesService().timeUntilNext(_timings);
        });
      }
    });
  }

  Future<void> _fetchPrayerTimes() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final useGPS = prefs.getBool('use_gps') ?? true;
      final method = prefs.getInt('prayer_method') ?? 13;
      final manualCity = prefs.getString('manual_city') ?? 'Ankara';
      final manualCountry = prefs.getString('manual_country') ?? 'Turkey';

      Map<String, dynamic> data;
      if (useGPS) {
        var perm = await Geolocator.checkPermission();
        if (perm == LocationPermission.denied)
          perm = await Geolocator.requestPermission();
        if (perm == LocationPermission.deniedForever) {
          data = await PrayerTimesService()
              .fetchByCity(city: 'Ankara', country: 'Turkey', method: method);
        } else {
          final pos = await Geolocator.getCurrentPosition(
            locationSettings: const LocationSettings(
                accuracy: LocationAccuracy.medium,
                timeLimit: Duration(seconds: 15)),
          );
          try {
            final pmarks =
                await placemarkFromCoordinates(pos.latitude, pos.longitude);
            if (pmarks.isNotEmpty)
              _cityName = pmarks.first.locality ??
                  pmarks.first.subAdministrativeArea ??
                  '';
          } catch (_) {}
          data = await PrayerTimesService().fetchByCoords(
              lat: pos.latitude, lon: pos.longitude, method: method);
        }
      } else {
        _cityName = manualCity;
        data = await PrayerTimesService().fetchByCity(
            city: manualCity, country: manualCountry, method: method);
      }

      final timings = PrayerTimesService().extractTimings(data);
      if (mounted) {
        setState(() {
          _timings = timings;
          _nextPrayer = PrayerTimesService().getNextPrayer(timings);
          _timeUntilNext = PrayerTimesService().timeUntilNext(timings);
          _loadingPrayer = false;
        });
      }
      if (_nextPrayer != null) {
        await HomeWidgetService.updatePrayerWidget(
          nextPrayer: _prayerLocal(_nextPrayer!),
          nextTime: timings[_nextPrayer] ?? '--:--',
          cityName: _cityName,
          allTimes: timings,
        );
      }
    } catch (_) {
      if (mounted) setState(() => _loadingPrayer = false);
    }
  }

  Future<void> _loadTodayStatus() async {
    final status = await PrayerTrackerService().getDayStatus(DateTime.now());
    if (mounted) setState(() => _todayStatus = status);
  }

  String _formatDuration(Duration d) {
    final h = d.inHours;
    final m = d.inMinutes.remainder(60);
    final s = d.inSeconds.remainder(60);
    if (h > 0) return '$h sa ${m.toString().padLeft(2, '0')} dk';
    return '${m.toString().padLeft(2, '0')}:${s.toString().padLeft(2, '0')}';
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final now = DateTime.now();
    const weekdays = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'];
    const months = [
      'Ocak',
