class PrayerTrackerService {
  static final PrayerTrackerService _i = PrayerTrackerService._();
  factory PrayerTrackerService() => _i;
  PrayerTrackerService._();

  String _dk(DateTime d) =>
      '${d.year}-${d.month.toString().padLeft(2, '0')}-${d.day.toString().padLeft(2, '0')}';
  String _pk(String dk, String p) => 'pt_${dk}_$p';

  Future<Map<String, bool>> getDayStatus(DateTime date) async {
    final p = await SharedPreferences.getInstance();
    final dk = _dk(date);
    return {
      for (final pr in kMainPrayerKeys) pr: p.getBool(_pk(dk, pr)) ?? false
    };
  }

  Future<void> togglePrayer(DateTime date, String prayer) async {
    final p = await SharedPreferences.getInstance();
    final key = _pk(_dk(date), prayer);
    await p.setBool(key, !(p.getBool(key) ?? false));
    await _recalcStreak();
    await _recalcTotal();
    await _checkBadges();
  }

  Future<int> getStreak() async =>
      (await SharedPreferences.getInstance()).getInt('prayer_streak') ?? 0;
  Future<int> getTotalCount() async =>
      (await SharedPreferences.getInstance()).getInt('prayer_total') ?? 0;

  Future<void> _recalcStreak() async {
    final p = await SharedPreferences.getInstance();
    int streak = 0;
    final now = DateTime.now();
    for (int i = 0; i < 365; i++) {
      final dk = _dk(now.subtract(Duration(days: i)));
      if (kMainPrayerKeys.every((pr) => p.getBool(_pk(dk, pr)) ?? false)) {
        streak++;
      } else
        break;
    }
    await p.setInt('prayer_streak', streak);
  }

  Future<void> _recalcTotal() async {
    final p = await SharedPreferences.getInstance();
    int total = 0;
    final now = DateTime.now();
    for (int i = 0; i < 365; i++) {
      final dk = _dk(now.subtract(Duration(days: i)));
      for (final pr in kMainPrayerKeys) {
        if (p.getBool(_pk(dk, pr)) ?? false) total++;
      }
    }
    await p.setInt('prayer_total', total);
  }

  Future<List<String>> getEarnedBadgeIds() async =>
      (await SharedPreferences.getInstance()).getStringList('earned_badges') ??
      [];

  Future<void> _checkBadges() async {
    final p = await SharedPreferences.getInstance();
    final streak = await getStreak();
    final total = await getTotalCount();
    final earned = await getEarnedBadgeIds();
    for (final b in kBadges) {
      final id = b['id'] as String;
      if (earned.contains(id)) continue;
      bool grant = false;
      if (id == 'first_prayer' && total >= 1) grant = true;
      if (id == 'streak_3' && streak >= 3) grant = true;
      if (id == 'streak_7' && streak >= 7) grant = true;
      if (id == 'streak_30' && streak >= 30) grant = true;
      if (id == 'total_100' && total >= 100) grant = true;
      if (id == 'total_500' && total >= 500) grant = true;
      if (grant) earned.add(id);
    }
    await p.setStringList('earned_badges', earned);
  }
}

