class SurahMeta {
  final int number;
  final String name;
  final String englishName;
  final String englishMeaning;
  final int ayahCount;
  final bool isMeccan;

  SurahMeta({
    required this.number,
    required this.name,
    required this.englishName,
    required this.englishMeaning,
    required this.ayahCount,
    required this.isMeccan,
  });

  factory SurahMeta.fromJson(Map<String, dynamic> j) => SurahMeta(
        number: j['number'] as int,
        name: j['name'] as String? ?? '',
        englishName: j['englishName'] as String? ?? '',
        englishMeaning: j['englishNameTranslation'] as String? ?? '',
        ayahCount: j['numberOfAyahs'] as int? ?? 0,
        isMeccan: (j['revelationType'] as String? ?? '') == 'Meccan',
      );
}

class AyahData {
  final int number; // global quran number
  final int numberInSurah;
  final String arabic;
  final String translation;
  final String audioUrl;

  AyahData({
    required this.number,
    required this.numberInSurah,
    required this.arabic,
    required this.translation,
    required this.audioUrl,
  });
}

