          height: 50,
          child: ListView.builder(
            scrollDirection: Axis.horizontal,
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
            itemCount: kZikirList.length,
            itemBuilder: (ctx, i) {
              final key = kZikirList.keys.elementAt(i);
              final sel = key == _selected;
              return GestureDetector(
                onTap: () => setState(() {
                  _selected = key;
                  _count = 0;
                }),
                child: Container(
                  margin: const EdgeInsets.only(right: 8),
                  padding: const EdgeInsets.symmetric(horizontal: 14),
                  decoration: BoxDecoration(
                      color: sel ? gold : gold.withOpacity(0.1),
                      borderRadius: BorderRadius.circular(20)),
                  child: Center(
                      child: Text(kZikirList[key]!['tr']!,
                          style: TextStyle(
                              fontSize: 11,
                              color: sel ? Colors.black : gold,
                              fontWeight: FontWeight.w600))),
                ),
              );
            },
          ),
        ),
        Expanded(
          child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
            Text(zikir['ar']!,
                style: GoogleFonts.notoNaskhArabic(fontSize: 32, color: gold),
                textDirection: TextDirection.rtl),
            const SizedBox(height: 8),
            Text(L.lang == AppLang.en ? zikir['en']! : zikir['tr']!,
                style: TextStyle(
                    fontSize: 14,
                    color: isDark ? Colors.white54 : Colors.black54)),
            const SizedBox(height: 40),
            Stack(alignment: Alignment.center, children: [
              SizedBox(
                width: 200,
                height: 200,
                child: CircularProgressIndicator(
                    value: progress,
                    strokeWidth: 8,
                    backgroundColor: gold.withOpacity(0.1),
                    valueColor: AlwaysStoppedAnimation<Color>(gold)),
              ),
              GestureDetector(
                onTap: _tap,
                child: Container(
                  width: 160,
                  height: 160,
                  decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      gradient: RadialGradient(colors: [
                        gold.withOpacity(0.25),
                        gold.withOpacity(0.05)
                      ]),
                      border:
                          Border.all(color: gold.withOpacity(0.4), width: 2)),
                  child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text('$_count',
                            style: TextStyle(
                                fontSize: 52,
                                fontWeight: FontWeight.w900,
                                color: gold)),
                        Text('/ $_target',
                            style: TextStyle(
                                fontSize: 14, color: gold.withOpacity(0.6))),
                      ]),
                ),
              ),
            ]),
            const SizedBox(height: 24),
            Row(mainAxisAlignment: MainAxisAlignment.center, children: [
              for (final t in [33, 99, 100, 1000])
                GestureDetector(
                  onTap: () => setState(() {
                    _target = t;
                    _count = 0;
                  }),
                  child: Container(
                    margin: const EdgeInsets.symmetric(horizontal: 6),
                    padding:
                        const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                    decoration: BoxDecoration(
                        color: _target == t ? gold : gold.withOpacity(0.1),
                        borderRadius: BorderRadius.circular(8)),
                    child: Text('$t',
                        style: TextStyle(
                            fontSize: 12,
                            color: _target == t ? Colors.black : gold,
                            fontWeight: FontWeight.w700)),
                  ),
                ),
            ]),
            const SizedBox(height: 16),
            Row(mainAxisAlignment: MainAxisAlignment.center, children: [
              TextButton.icon(
                  icon: Icon(Icons.refresh, color: gold, size: 18),
                  label: Text(L.reset, style: TextStyle(color: gold)),
                  onPressed: () => setState(() => _count = 0)),
              const SizedBox(width: 16),
              TextButton.icon(
                icon: Icon(_vibrate ? Icons.vibration : Icons.do_not_disturb,
                    color: gold, size: 18),
                label: Text(_vibrate ? 'Titreşim Açık' : 'Titreşim Kapalı',
                    style: TextStyle(color: gold, fontSize: 12)),
                onPressed: () => setState(() => _vibrate = !_vibrate),
              ),
            ]),
          ]),
        ),
        const AdBannerWidget(),
      ]),
    );
  }
}
