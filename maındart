class PrayerTimesService {
  static final PrayerTimesService _i = PrayerTimesService._();
  factory PrayerTimesService() => _i;
  PrayerTimesService._();

  Future<Map<String, dynamic>> fetchByCoords({
    required double lat,
    required double lon,
    required int method,
    DateTime? date,
  }) async {
    final d = date ?? DateTime.now();
    final ds =
        '${d.day.toString().padLeft(2, '0')}-${d.month.toString().padLeft(2, '0')}-${d.year}';
    final url =
        'https://api.aladhan.com/v1/timings/$ds?latitude=$lat&longitude=$lon&method=$method';
    final r =
        await http.get(Uri.parse(url)).timeout(const Duration(seconds: 20));
    if (r.statusCode != 200) throw Exception('HTTP ${r.statusCode}');
    final data = jsonDecode(r.body) as Map<String, dynamic>;
    if (data['code'] != 200) throw Exception(data['status']);
    return data['data'] as Map<String, dynamic>;
  }

  Future<Map<String, dynamic>> fetchByCity({
    required String city,
    required String country,
    required int method,
    DateTime? date,
  }) async {
    final d = date ?? DateTime.now();
    final ds =
        '${d.day.toString().padLeft(2, '0')}-${d.month.toString().padLeft(2, '0')}-${d.year}';
    final url =
        'https://api.aladhan.com/v1/timingsByCity/$ds?city=${Uri.encodeComponent(city)}&country=${Uri.encodeComponent(country)}&method=$method';
    final r =
        await http.get(Uri.parse(url)).timeout(const Duration(seconds: 20));
    if (r.statusCode != 200) throw Exception('HTTP ${r.statusCode}');
    final data = jsonDecode(r.body) as Map<String, dynamic>;
    if (data['code'] != 200) throw Exception(data['status']);
    return data['data'] as Map<String, dynamic>;
  }

  Map<String, String> extractTimings(Map<String, dynamic> data) {
    final t = data['timings'] as Map<String, dynamic>;
    return t.map((k, v) => MapEntry(k, (v as String).split(' ').first));
  }

  String? getNextPrayer(Map<String, String> timings) {
    final now = DateTime.now();
    for (final key in kMainPrayerKeys) {
      final t = timings[key];
      if (t == null) continue;
      final parts = t.split(':');
      if (parts.length < 2) continue;
      final dt = DateTime(now.year, now.month, now.day, int.parse(parts[0]),
          int.parse(parts[1]));
      if (dt.isAfter(now)) return key;
    }
    return kMainPrayerKeys.first;
  }

  Duration? timeUntilNext(Map<String, String> timings) {
    final now = DateTime.now();
    final next = getNextPrayer(timings);
    if (next == null) return null;
    final t = timings[next];
    if (t == null) return null;
    final parts = t.split(':');
    if (parts.length < 2) return null;
    var dt = DateTime(
        now.year, now.month, now.day, int.parse(parts[0]), int.parse(parts[1]));
    if (dt.isBefore(now)) dt = dt.add(const Duration(days: 1));
    return dt.difference(now);
  }
}

