class QiblaScreen extends StatefulWidget {
  const QiblaScreen({super.key});

  @override
  State<QiblaScreen> createState() => _QiblaScreenState();
}

class _QiblaScreenState extends State<QiblaScreen>
    with SingleTickerProviderStateMixin {
  double _qiblaAngle = 0; // degrees from North, clockwise
  double _compassHeading = 0; // device heading from North
  bool _hasLocation = false;
  bool _aligned = false;
  String _error = '';
  String _locationName = '';
  double _distanceKm = 0;
  StreamSubscription<CompassEvent>? _compassSub;
  late AnimationController _pulseCtrl;

  @override
  void initState() {
    super.initState();
    _pulseCtrl =
        AnimationController(vsync: this, duration: const Duration(seconds: 2))
          ..repeat(reverse: true);
    _initQibla();
  }

  Future<void> _initQibla() async {
    try {
      var perm = await Geolocator.checkPermission();
      if (perm == LocationPermission.denied) {
        perm = await Geolocator.requestPermission();
      }
      if (perm == LocationPermission.denied ||
          perm == LocationPermission.deniedForever) {
        setState(() => _error = L.locationPermDenied);
        return;
      }

      final pos = await Geolocator.getCurrentPosition(
          desiredAccuracy: LocationAccuracy.medium);

      // Haversine bearing to Kaaba
      final q = _haversineQibla(pos.latitude, pos.longitude);
      // Distance to Kaaba
      final dist = Geolocator.distanceBetween(
              pos.latitude, pos.longitude, kKaabaLat, kKaabaLon) /
          1000;

      // Reverse geocode
      try {
        final places =
            await placemarkFromCoordinates(pos.latitude, pos.longitude);
        if (places.isNotEmpty) {
          _locationName =
              '${places.first.locality ?? ''}, ${places.first.country ?? ''}';
        }
      } catch (_) {}

      if (mounted) {
        setState(() {
          _qiblaAngle = q;
          _distanceKm = dist;
          _hasLocation = true;
        });
      }

      // Start compass stream
      _compassSub = FlutterCompass.events?.listen((event) {
        if (event.heading == null) return;
        if (mounted) {
          final diff = (_qiblaAngle - event.heading!).abs() % 360;
          setState(() {
            _compassHeading = event.heading!;
            _aligned = diff < 5 || diff > 355;
          });
        }
      });
    } catch (e) {
      if (mounted) setState(() => _error = e.toString());
    }
  }

  // Haversine formula — azimuth from current position to Kaaba
  // Returns bearing 0-360° clockwise from North
  double _haversineQibla(double lat, double lon) {
    final lat1 = lat * math.pi / 180;
    final lat2 = kKaabaLat * math.pi / 180;
    final dLon = (kKaabaLon - lon) * math.pi / 180;

    final y = math.sin(dLon) * math.cos(lat2);
    final x = math.cos(lat1) * math.sin(lat2) -
        math.sin(lat1) * math.cos(lat2) * math.cos(dLon);

    double bearing = math.atan2(y, x) * 180 / math.pi;
    return (bearing + 360) % 360;
  }

  @override
  void dispose() {
    _compassSub?.cancel();
    _pulseCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final teal = Theme.of(context).colorScheme.secondary;
    final isDark = Theme.of(context).brightness == Brightness.dark;

    if (_error.isNotEmpty) {
      return Scaffold(
        appBar: AppBar(title: Text(L.qiblaFinder)),
        body: Center(
          child: Padding(
            padding: const EdgeInsets.all(24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(Icons.location_off, size: 48, color: Colors.red),
                const SizedBox(height: 16),
                Text(_error,
                    textAlign: TextAlign.center,
                    style: const TextStyle(color: Colors.red, fontSize: 14)),
                const SizedBox(height: 16),
                ElevatedButton(
                    onPressed: () {
                      setState(() => _error = '');
                      _initQibla();
                    },
                    child: const Text('Tekrar Dene / Retry')),
              ],
            ),
          ),
        ),
      );
    }

    if (!_hasLocation) {
      return Scaffold(
          appBar: AppBar(title: Text(L.qiblaFinder)), body: _loadingCenter());
    }

    // The needle should point toward Qibla.
    // Device heading = compass direction phone is facing.
    // Arrow rotation = qiblaAngle - compassHeading  (so 0° = phone pointing at Qibla)
    final arrowAngle = (_qiblaAngle - _compassHeading) * math.pi / 180;

    return Scaffold(
      appBar: AppBar(title: Text(L.qiblaFinder)),
      body: SafeArea(
        child: SingleChildScrollView(
          child: Padding(
            padding: const EdgeInsets.all(20),
            child: Column(
              children: [
                Text(L.calibrate,
                    textAlign: TextAlign.center,
                    style: TextStyle(
                        fontSize: 12,
                        color: isDark ? Colors.white54 : Colors.black45)),
                const SizedBox(height: 20),
                // Compass + Arrow
                SizedBox(
                  width: 280,
                  height: 280,
                  child: Stack(
                    alignment: Alignment.center,
                    children: [
                      // Outer ring
                      AnimatedBuilder(
                        animation: _pulseCtrl,
                        builder: (_, __) => Container(
                          width: 280,
                          height: 280,
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            border: Border.all(
                                color: (_aligned ? teal : gold)
                                    .withOpacity(0.3 + _pulseCtrl.value * 0.3),
                                width: 2),
                          ),
                        ),
                      ),
                      // Cardinal directions
                      ...[
                        _CompassLabel('N', const Offset(0, -120)),
                        _CompassLabel('S', const Offset(0, 120)),
                        _CompassLabel('E', const Offset(120, 0)),
                        _CompassLabel('W', const Offset(-120, 0)),
                      ],
                      // Kaaba icon at center
                      Container(
                        width: 42,
                        height: 42,
                        decoration: BoxDecoration(
                          shape: BoxShape.circle,
                          color: gold.withOpacity(0.12),
                          border: Border.all(color: gold.withOpacity(0.4)),
                        ),
                        child: Center(
                          child:
                              Text('🕋', style: const TextStyle(fontSize: 20)),
                        ),
                      ),
                      // Rotating arrow — points to Qibla
                      Transform.rotate(
                        angle: arrowAngle,
                        child: Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Icon(Icons.navigation,
                                size: 80, color: _aligned ? teal : gold),
                            const SizedBox(height: 50),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 24),
                // Info card
                Container(
                  padding: const EdgeInsets.all(16),
                  decoration: BoxDecoration(
                    color: isDark ? const Color(0xFF161B22) : Colors.white,
                    borderRadius: BorderRadius.circular(16),
                    border: Border.all(
                        color: (_aligned ? teal : gold).withOpacity(0.3)),
                  ),
                  child: Column(
                    children: [
                      if (_aligned)
                        Container(
                          padding: const EdgeInsets.symmetric(
                              horizontal: 14, vertical: 6),
                          decoration: BoxDecoration(
                            color: teal.withOpacity(0.15),
                            borderRadius: BorderRadius.circular(20),
                          ),
                          child: Text('✓ Kıble Yönü Bulundu!',
                              style: TextStyle(
                                  color: teal, fontWeight: FontWeight.w700)),
                        ),
                      const SizedBox(height: 8),
                      _InfoRow(L.qiblaDir, '${_qiblaAngle.toStringAsFixed(1)}°',
                          gold),
                      _InfoRow(L.deviceHeading,
                          '${_compassHeading.toStringAsFixed(1)}°', null),
                      _InfoRow('Kabe Mesafesi',
                          '${_distanceKm.toStringAsFixed(0)} km', teal),
                      if (_locationName.isNotEmpty)
                        _InfoRow('Konum', _locationName, null),
                    ],
                  ),
                ),
                const SizedBox(height: 14),
                Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: isDark ? const Color(0xFF161B22) : Colors.white,
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                        color: isDark
                            ? Colors.white.withOpacity(0.07)
                            : Colors.black.withOpacity(0.07)),
                  ),
                  child: Column(
                    children: [
                      Text('🕋 Kabe Koordinatları',
                          style: TextStyle(
                              fontSize: 12,
                              color: gold,
                              fontWeight: FontWeight.w700)),
                      const SizedBox(height: 4),
                      Text('21.4225°K,  39.8262°D',
                          style: TextStyle(
                              fontSize: 12,
                              color: isDark ? Colors.white54 : Colors.black45)),
                      const SizedBox(height: 2),
                      Text('Hesaplama: Haversine Formülü',
                          style: TextStyle(
                              fontSize: 11,
                              color: isDark ? Colors.white38 : Colors.black38)),
                    ],
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

