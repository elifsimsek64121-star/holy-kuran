class PrayerTimesScreen extends StatefulWidget {
  const PrayerTimesScreen({super.key});

  @override
  State<PrayerTimesScreen> createState() => _PrayerTimesScreenState();
}

class _PrayerTimesScreenState extends State<PrayerTimesScreen>
    with TickerProviderStateMixin {
  Map<String, String>? _timings;
  Map<String, String>? _hijriDate;
  String _locationInfo = '';
  bool _loading = true;
  String _error = '';
  String _nextPrayer = '';
  Duration _remaining = Duration.zero;
  Timer? _timer;
  late AnimationController _pulseCtrl;
  late AnimationController _progressCtrl;
  String _calculationMethod = '5'; // Diyanet = 5
  String _methodName = 'Diyanet İşleri (Türkiye)';

  static const List<String> _prayerKeys = [
    'Imsak',
    'Fajr',
    'Sunrise',
    'Dhuhr',
    'Asr',
    'Maghrib',
    'Isha',
  ];

  static final Map<String, String> _prayerNamesTr = {
    'Imsak': 'İmsak',
    'Fajr': 'Sabah',
    'Sunrise': 'Güneş',
    'Dhuhr': 'Öğle',
    'Asr': 'İkindi',
    'Maghrib': 'Akşam',
    'Isha': 'Yatsı',
    'Midnight': 'Gece Yarısı',
  };

  static final Map<String, String> _prayerNamesEn = {
    'Imsak': 'Imsak',
    'Fajr': 'Fajr',
    'Sunrise': 'Sunrise',
    'Dhuhr': 'Dhuhr',
    'Asr': 'Asr',
    'Maghrib': 'Maghrib',
    'Isha': 'Isha',
    'Midnight': 'Midnight',
  };

  static const Map<String, String> _calcMethods = {
    '5': 'Diyanet İşleri (Türkiye)',
    '2': 'Islamic Society of North America (ISNA)',
    '3': 'Muslim World League (MWL)',
    '4': 'Umm Al-Qura University, Makkah',
    '1': 'University of Islamic Sciences, Karachi',
    '7': 'Institute of Geophysics, University of Tehran',
  };

  String _prayerName(String key) {
    if (L.lang == AppLang.en) return _prayerNamesEn[key] ?? key;
    return _prayerNamesTr[key] ?? key;
  }

  @override
  void initState() {
    super.initState();
    _pulseCtrl =
        AnimationController(vsync: this, duration: const Duration(seconds: 2))
          ..repeat(reverse: true);
    _progressCtrl =
        AnimationController(vsync: this, duration: const Duration(seconds: 1));
    _fetch();
  }

  @override
  void dispose() {
    _timer?.cancel();
    _pulseCtrl.dispose();
    _progressCtrl.dispose();
    super.dispose();
  }

  Future<void> _fetch() async {
    if (mounted) {
      setState(() {
        _loading = true;
        _error = '';
        _locationInfo = '';
      });
    }
    try {
      var perm = await Geolocator.checkPermission();
      if (perm == LocationPermission.denied) {
        perm = await Geolocator.requestPermission();
      }
      if (perm == LocationPermission.denied ||
          perm == LocationPermission.deniedForever) {
        throw Exception(L.locationPermDenied);
      }

      final pos = await Geolocator.getCurrentPosition(
          desiredAccuracy: LocationAccuracy.medium);

      String city = '';
      String country = '';
      try {
        final places =
            await placemarkFromCoordinates(pos.latitude, pos.longitude);
        if (places.isNotEmpty) {
          final p = places.first;
          city = (p.locality ??
                  p.subAdministrativeArea ??
                  p.administrativeArea ??
                  '')
              .trim();
          country = (p.country ?? '').trim();
        }
      } catch (_) {}

      _locationInfo = city.isNotEmpty
          ? (country.isNotEmpty ? '$city, $country' : city)
          : '${pos.latitude.toStringAsFixed(3)}°, ${pos.longitude.toStringAsFixed(3)}°';

      final now = DateTime.now();
      final ts = now.millisecondsSinceEpoch ~/ 1000;
      final url =
          'https://api.aladhan.com/v1/timings/$ts?latitude=${pos.latitude}&longitude=${pos.longitude}&method=$_calculationMethod';

      final r =
          await http.get(Uri.parse(url)).timeout(const Duration(seconds: 25));
      if (r.statusCode != 200) {
        throw Exception('API bağlantı hatası (${r.statusCode})');
      }

      final data = jsonDecode(r.body)['data'];
      final timings = Map<String, String>.from(data['timings'] as Map);
      final hijri = data['date']['hijri'] as Map;

      if (mounted) {
        setState(() {
          _timings = timings;
          _hijriDate = {
            'day': hijri['day'] as String,
            'month': (hijri['month'] as Map)['en'] as String,
            'monthAr': (hijri['month'] as Map)['ar'] as String? ?? '',
            'year': hijri['year'] as String,
            'weekday': (hijri['weekday'] as Map)['en'] as String? ?? '',
          };
          _loading = false;
        });
        _computeNextPrayer();
        _timer?.cancel();
        _timer = Timer.periodic(
            const Duration(seconds: 10), (_) => _computeNextPrayer());
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          _loading = false;
          _error = e.toString().replaceAll('Exception: ', '');
        });
      }
    }
  }

  void _computeNextPrayer() {
    if (_timings == null || !mounted) return;

    final now = DateTime.now();
    final currentMinutes = now.hour * 60 + now.minute;
    final mainPrayers = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];

    String? nextKey;
    int? nextMinutes;

    for (final key in mainPrayers) {
      final timeStr = _timings![key];
      if (timeStr == null) continue;
      final parts = timeStr.split(':');
      final h = int.tryParse(parts[0]) ?? 0;
      final m = int.tryParse(parts[1].split(RegExp(r'[^0-9]'))[0]) ?? 0;
      final prayerMinutes = h * 60 + m;
      if (prayerMinutes > currentMinutes) {
        nextKey = key;
        nextMinutes = prayerMinutes;
        break;
      }
    }

    if (nextKey == null) {
      nextKey = 'Fajr';
      final fajrTime = _timings!['Fajr'];
      if (fajrTime != null) {
        final parts = fajrTime.split(':');
        final h = int.tryParse(parts[0]) ?? 0;
        final m = int.tryParse(parts[1].split(RegExp(r'[^0-9]'))[0]) ?? 0;
        nextMinutes = h * 60 + m + (24 * 60);
      } else {
        nextMinutes = 24 * 60;
      }
    }

    if (nextMinutes != null && nextKey != null) {
      int remainingMinutes = nextMinutes - currentMinutes;
      if (remainingMinutes < 0) remainingMinutes += 24 * 60;
      if (mounted) {
        setState(() {
          _nextPrayer = nextKey!;
          _remaining = Duration(minutes: remainingMinutes);
        });
      }
    }
  }

  String _formatRemaining() {
    if (_remaining.inMinutes <= 0) return '0 dk';
    final hours = _remaining.inHours;
    final minutes = _remaining.inMinutes % 60;
    return hours > 0 ? '$hours s $minutes dk' : '$minutes dk';
  }

  // Güncel saate göre progress (iki namaz arası)
  double _getPrayerProgress() {
    if (_timings == null || _nextPrayer.isEmpty) return 0.0;
    final mainPrayers = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];
    final nextIdx = mainPrayers.indexOf(_nextPrayer);
    if (nextIdx <= 0) return 0.0;
    final prevKey = mainPrayers[nextIdx - 1];

    final now = DateTime.now();
    final nowMin = now.hour * 60 + now.minute;

    int _parseMin(String key) {
      final parts = (_timings![key] ?? '00:00').split(':');
      return (int.tryParse(parts[0]) ?? 0) * 60 +
          (int.tryParse(parts[1].split(RegExp(r'[^0-9]'))[0]) ?? 0);
    }

    final prevMin = _parseMin(prevKey);
    final nextMin = _parseMin(_nextPrayer);
    if (nextMin <= prevMin) return 0.0;
    return ((nowMin - prevMin) / (nextMin - prevMin)).clamp(0.0, 1.0);
  }

