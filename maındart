class QuranApp extends StatefulWidget {
  final bool initialDark;
  final String initialReciter;
  final String initialTranslation;

  const QuranApp({
    super.key,
    required this.initialDark,
    required this.initialReciter,
    required this.initialTranslation,
  });

  static _QuranAppState? of(BuildContext context) =>
      context.findAncestorStateOfType<_QuranAppState>();

  @override
  State<QuranApp> createState() => _QuranAppState();
}

class _QuranAppState extends State<QuranApp> {
  late bool isDark;
  late String reciter;
  late String translation;

  @override
  void initState() {
    super.initState();
    isDark = widget.initialDark;
    reciter = widget.initialReciter;
    translation = widget.initialTranslation;
  }

  Future<void> toggleTheme() async {
    setState(() => isDark = !isDark);
    final p = await SharedPreferences.getInstance();
    await p.setBool('dark_mode', isDark);
  }

  Future<void> setLanguage(AppLang lang) async {
    setState(() => L.lang = lang);
    final p = await SharedPreferences.getInstance();
    await p.setString('language', lang.name);
  }

  Future<void> setReciter(String r) async {
    setState(() => reciter = r);
    final p = await SharedPreferences.getInstance();
    await p.setString('reciter', r);
  }

  Future<void> setTranslation(String t) async {
    setState(() => translation = t);
    final p = await SharedPreferences.getInstance();
    await p.setString('translation', t);
  }

  @override
  Widget build(BuildContext context) {
    final gold = const Color(0xFFC9A84C);
    final teal = const Color(0xFF1ABC9C);

    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Kur\'an-ı Kerim',
      theme: ThemeData(
        useMaterial3: true,
        brightness: isDark ? Brightness.dark : Brightness.light,
        scaffoldBackgroundColor:
            isDark ? const Color(0xFF0D1117) : const Color(0xFFF8F5F0),
        colorScheme: isDark
            ? ColorScheme.dark(
                primary: gold,
                secondary: teal,
                surface: const Color(0xFF161B22),
                surfaceContainerHighest: const Color(0xFF21262D),
              )
            : ColorScheme.light(
                primary: gold,
