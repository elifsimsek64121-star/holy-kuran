class PrayerTimesScreen extends StatefulWidget {
  const PrayerTimesScreen({super.key});
  @override
  State<PrayerTimesScreen> createState() => _PrayerTimesScreenState();
}

class _PrayerTimesScreenState extends State<PrayerTimesScreen>
    with TickerProviderStateMixin {
  Map<String, String> _timings = {};
  Map<String, dynamic>? _meta;
  bool _loading = true;
  String _error = '';
  String _cityName = '';
  String _countryName = '';
  int _method = 13;
  bool _useGPS = true;
  String _manualCity = '';
  String _manualCountry = 'Turkey';
  Timer? _timer;
  Duration? _timeUntilNext;
  String? _nextPrayer;
  bool _notificationsEnabled = true;
  bool _adhanEnabled = true;
  Map<String, bool> _todayStatus = {};
  late AnimationController _pulseCtrl;
  late Animation<double> _pulseAnim;

  @override
  void initState() {
    super.initState();
    _pulseCtrl =
        AnimationController(vsync: this, duration: const Duration(seconds: 2));
    _pulseAnim = Tween<double>(begin: 1.0, end: 1.05)
        .animate(CurvedAnimation(parent: _pulseCtrl, curve: Curves.easeInOut));
    _pulseCtrl.repeat(reverse: true);
    _loadSettings();
    _fetchPrayerTimes();
    _loadTodayStatus();
    _startTimer();
  }

  Future<void> _loadSettings() async {
    final p = await SharedPreferences.getInstance();
    if (mounted)
      setState(() {
        _method = p.getInt('prayer_method') ?? 13;
        _useGPS = p.getBool('use_gps') ?? true;
        _manualCity = p.getString('manual_city') ?? '';
        _manualCountry = p.getString('manual_country') ?? 'Turkey';
        _notificationsEnabled = p.getBool('notifications_enabled') ?? true;
        _adhanEnabled = p.getBool('adhan_enabled') ?? true;
      });
  }

  Future<void> _loadTodayStatus() async {
    final s = await PrayerTrackerService().getDayStatus(DateTime.now());
    if (mounted) setState(() => _todayStatus = s);
  }

  void _startTimer() {
    _timer = Timer.periodic(const Duration(seconds: 1), (_) {
      if (_timings.isNotEmpty && mounted)
        setState(() {
          _nextPrayer = PrayerTimesService().getNextPrayer(_timings);
          _timeUntilNext = PrayerTimesService().timeUntilNext(_timings);
        });
    });
  }

  Future<void> _fetchPrayerTimes() async {
    if (mounted)
      setState(() {
        _loading = true;
        _error = '';
      });
    try {
      Map<String, dynamic> data;
      if (_useGPS) {
        var perm = await Geolocator.checkPermission();
        if (perm == LocationPermission.denied)
          perm = await Geolocator.requestPermission();
        if (perm == LocationPermission.deniedForever)
          throw Exception(L.locationPermDenied);
        final pos = await Geolocator.getCurrentPosition(
            locationSettings: const LocationSettings(
                accuracy: LocationAccuracy.medium,
                timeLimit: Duration(seconds: 15)));
        try {
          final pm =
              await placemarkFromCoordinates(pos.latitude, pos.longitude);
          if (pm.isNotEmpty) {
            _cityName =
                pm.first.locality ?? pm.first.subAdministrativeArea ?? '';
            _countryName = pm.first.country ?? '';
          }
        } catch (_) {}
        data = await PrayerTimesService().fetchByCoords(
            lat: pos.latitude, lon: pos.longitude, method: _method);
      } else {
        _cityName = _manualCity;
        _countryName = _manualCountry;
        data = await PrayerTimesService().fetchByCity(
            city: _manualCity.isNotEmpty ? _manualCity : 'Istanbul',
            country: _manualCountry.isNotEmpty ? _manualCountry : 'Turkey',
            method: _method);
      }
      final timings = PrayerTimesService().extractTimings(data);
      final nextPrayer = PrayerTimesService().getNextPrayer(timings);
      final dur = PrayerTimesService().timeUntilNext(timings);
      if (mounted)
        setState(() {
          _timings = timings;
          _meta = data;
          _nextPrayer = nextPrayer;
          _timeUntilNext = dur;
          _loading = false;
        });
      await NotificationService().schedulePrayerNotifications(
          times: timings,
          cityName:
              '$_cityName${_countryName.isNotEmpty ? ", $_countryName" : ""}',
          adhanEnabled: _adhanEnabled,
          notificationsEnabled: _notificationsEnabled);
      if (nextPrayer != null) {
        await HomeWidgetService.updatePrayerWidget(
            nextPrayer: _prayerLocal(nextPrayer),
            nextTime: timings[nextPrayer] ?? '--:--',
            cityName: _cityName,
            allTimes: timings);
      }
    } catch (e) {
      if (mounted)
        setState(() {
          _loading = false;
          _error = e.toString();
        });
    }
  }

  @override
  void dispose() {
    _timer?.cancel();
    _pulseCtrl.dispose();
    super.dispose();
  }

  String _formatDur(Duration d) {
    final h = d.inHours;
    final m = d.inMinutes.remainder(60);
    final s = d.inSeconds.remainder(60);
    if (h > 0) return '$h sa ${m.toString().padLeft(2, '0')} dk';
    return '${m.toString().padLeft(2, '0')}:${s.toString().padLeft(2, '0')}';
  }

