class SurahDetailScreen extends StatefulWidget {
  final SurahMeta surah;
  final String reciter;
  final String translation;
  final int scrollToAyah;

  const SurahDetailScreen({
    super.key,
    required this.surah,
    required this.reciter,
    required this.translation,
    this.scrollToAyah = 0,
  });

  @override
  State<SurahDetailScreen> createState() => _SurahDetailScreenState();
}

class _SurahDetailScreenState extends State<SurahDetailScreen> {
  List<AyahData> _ayahs = [];
  bool _loading = true;
  String _error = '';
  final _player = AudioPlayer();
  int _playingIdx = -1;
  bool _isPlaying = false;
  bool _audioLoading = false;
  Set<int> _bookmarks = {};
  final _scrollCtrl = ScrollController();
  final Map<int, GlobalKey> _keys = {};
  double _fontSize = 24;

  @override
  void initState() {
    super.initState();
    _fetchSurah();
    _loadBookmarks();
    _setupAudio();
  }

  Future<void> _setupAudio() async {
    final session = await AudioSession.instance;
    await session.configure(const AudioSessionConfiguration.speech());
    _player.playerStateStream.listen((state) {
      if (mounted) setState(() => _isPlaying = state.playing);
    });
    _player.processingStateStream.listen((ps) {
      if (ps == ProcessingState.completed) _onComplete();
    });
  }

  // API: alquran.cloud — uthmani + translation
  Future<void> _fetchSurah() async {
    setState(() {
      _loading = true;
      _error = '';
    });
    try {
      final url =
          'https://api.alquran.cloud/v1/surah/${widget.surah.number}/editions/quran-uthmani,${widget.translation}';
      final r =
          await http.get(Uri.parse(url)).timeout(const Duration(seconds: 20));
      if (r.statusCode != 200) throw Exception('HTTP ${r.statusCode}');
      final data = jsonDecode(r.body)['data'] as List;
      final uthmani =
          data.firstWhere((e) => e['edition']['identifier'] == 'quran-uthmani');
      final trans = data.firstWhere(
        (e) => e['edition']['identifier'] == widget.translation,
        orElse: () => uthmani,
      );
      final uthmaniAyahs = uthmani['ayahs'] as List;
      final transAyahs = trans['ayahs'] as List;

      final List<AyahData> ayahs = [];
      for (int i = 0; i < uthmaniAyahs.length; i++) {
        final u = uthmaniAyahs[i];
        final t = i < transAyahs.length ? transAyahs[i] : u;
        ayahs.add(AyahData(
          number: u['number'] as int,
          numberInSurah: u['numberInSurah'] as int,
          arabic: u['text'] as String,
          translation:
              (t['text'] as String?)?.replaceAll(RegExp(r'^\d+\.\s*'), '') ??
                  '',
          audioUrl: ayahAudioUrl(
            widget.surah.number,
            u['numberInSurah'] as int,
          ),
        ));
        _keys[i] = GlobalKey();
      }

      if (mounted) {
        setState(() {
          _ayahs = ayahs;
          _loading = false;
        });
        if (widget.scrollToAyah > 0) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            _scrollTo(widget.scrollToAyah - 1);
          });
        }
      }
    } catch (e) {
      if (mounted)
        setState(() {
          _loading = false;
          _error = e.toString();
        });
    }
  }

  Future<void> _loadBookmarks() async {
    final p = await SharedPreferences.getInstance();
    final list = p.getStringList('bm_${widget.surah.number}') ?? [];
    setState(() => _bookmarks = list.map(int.parse).toSet());
  }

  Future<void> _toggleBookmark(int idx) async {
    final p = await SharedPreferences.getInstance();
    setState(() {
      if (_bookmarks.contains(idx)) {
        _bookmarks.remove(idx);
      } else {
        _bookmarks.add(idx);
      }
    });
    await p.setStringList('bm_${widget.surah.number}',
        _bookmarks.map((e) => e.toString()).toList());
  }

  Future<void> _saveLastPos(int ayahIdx) async {
    final p = await SharedPreferences.getInstance();
    await p.setInt('last_surah', widget.surah.number);
    await p.setInt('last_ayah', _ayahs[ayahIdx].numberInSurah);
  }

  Future<void> _playAyah(int idx) async {
    if (idx < 0 || idx >= _ayahs.length) return;

    if (_playingIdx == idx && _isPlaying) {
      await _player.pause();
      return;
    }
    if (_playingIdx == idx && !_isPlaying) {
      await _player.play();
      return;
    }

    setState(() {
      _playingIdx = idx;
      _audioLoading = true;
    });
    _scrollTo(idx);
    await _saveLastPos(idx);

    try {
      await _player.setUrl(_ayahs[idx].audioUrl);
      await _player.play();
      setState(() => _audioLoading = false);
    } catch (e) {
      // fallback: try another CDN
      try {
        final s = widget.surah.number.toString().padLeft(3, '0');
        final a = _ayahs[idx].numberInSurah.toString().padLeft(3, '0');
        await _player.setUrl(
            'https://cdn.islamic.network/quran/audio/128/ar.alafasy/${'${_ayahs[idx].number}'}.mp3');
        await _player.play();
      } catch (_) {}
      setState(() => _audioLoading = false);
    }
  }

  void _onComplete() {
    final next = _playingIdx + 1;
    if (next < _ayahs.length) {
      Future.delayed(const Duration(milliseconds: 300), () => _playAyah(next));
    } else {
      setState(() {
        _playingIdx = -1;
        _isPlaying = false;
      });
    }
  }

  void _scrollTo(int idx) {
    final key = _keys[idx];
    if (key?.currentContext != null) {
      Scrollable.ensureVisible(
        key!.currentContext!,
        duration: const Duration(milliseconds: 500),
        alignment: 0.3,
        curve: Curves.easeInOut,
      );
    }
  }

  @override
  void dispose() {
    _player.dispose();
    _scrollCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final teal = Theme.of(context).colorScheme.secondary;
    final isDark = Theme.of(context).brightness == Brightness.dark;

    return Scaffold(
      appBar: AppBar(
        title: Text(widget.surah.englishName),
        actions: [
          IconButton(
            icon: const Icon(Icons.text_increase, size: 20),
            onPressed: () => setState(
                () => _fontSize = (_fontSize + 2).clamp(16, 36).toDouble()),
          ),
          IconButton(
            icon: const Icon(Icons.text_decrease, size: 20),
            onPressed: () => setState(
                () => _fontSize = (_fontSize - 2).clamp(16, 36).toDouble()),
          ),
        ],
      ),
      body: _loading
          ? _loadingCenter()
          : _error.isNotEmpty
              ? _errorCenter(_error, _fetchSurah)
              : Column(
                  children: [
                    // Surah header
                    Container(
                      padding: const EdgeInsets.symmetric(vertical: 14),
                      decoration: BoxDecoration(
                        color: isDark
                            ? const Color(0xFF161B22)
                            : const Color(0xFFFAF7F0),
                        border: Border(
                          bottom: BorderSide(color: gold.withOpacity(0.2)),
                        ),
                      ),
                      child: Column(
                        children: [
                          Text(
                            widget.surah.name,
                            style: GoogleFonts.notoNaskhArabic(
                                fontSize: 30,
                                fontWeight: FontWeight.w700,
                                color: gold),
                            textDirection: TextDirection.rtl,
                          ),
                          const SizedBox(height: 4),
                          Text(
                            '${widget.surah.englishName}  •  ${widget.surah.ayahCount} ${L.verses}  •  ${widget.surah.isMeccan ? L.meccan : L.medinan}',
                            style: TextStyle(
                                fontSize: 12,
                                color:
                                    isDark ? Colors.white54 : Colors.black45),
                          ),
                          if (widget.surah.number != 9) ...[
                            const SizedBox(height: 8),
                            Text(
                              'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ',
                              style: GoogleFonts.notoNaskhArabic(
                                  fontSize: 20,
                                  color:
                                      isDark ? Colors.white70 : Colors.black54),
                              textDirection: TextDirection.rtl,
                            ),
                          ],
                        ],
                      ),
                    ),
                    // Ayah list
                    Expanded(
                      child: ListView.builder(
                        controller: _scrollCtrl,
                        padding: const EdgeInsets.fromLTRB(12, 8, 12, 100),
                        itemCount: _ayahs.length,
                        itemBuilder: (ctx, i) => _AyahCard(
                          key: _keys[i],
                          ayah: _ayahs[i],
                          isPlaying: _playingIdx == i && _isPlaying,
                          isLoading: _playingIdx == i && _audioLoading,
                          isBookmarked: _bookmarks.contains(i),
                          fontSize: _fontSize,
                          onPlay: () => _playAyah(i),
                          onBookmark: () => _toggleBookmark(i),
                          onShare: () => Share.share(
                              '${_ayahs[i].arabic}\n${_ayahs[i].translation}\n(${widget.surah.englishName} ${_ayahs[i].numberInSurah})'),
                          onCopy: () {
                            Clipboard.setData(ClipboardData(
                                text:
                                    '${_ayahs[i].arabic}\n${_ayahs[i].translation}'));
                            ScaffoldMessenger.of(context).showSnackBar(SnackBar(
                                content: Text(L.copied),
                                duration: const Duration(seconds: 1)));
                          },
                        ),
                      ),
                    ),
                  ],
                ),
      // Mini player bar
      bottomNavigationBar: _playingIdx >= 0
          ? _MiniPlayer(
              ayah: _ayahs[_playingIdx],
              surahName: widget.surah.englishName,
              isPlaying: _isPlaying,
              isLoading: _audioLoading,
              onPlayPause: () => _playAyah(_playingIdx),
              onPrev: () => _playAyah(_playingIdx - 1),
              onNext: () => _playAyah(_playingIdx + 1),
            )
          : null,
    );
  }
}

