  Widget _buildPageContent(List<Map<String, dynamic>> ayahs, int page,
      Color gold, bool isDark, Color bg) {
    // Gruplama: sure başlıkları için
    String? currentSurahName;
    final widgets = <Widget>[];

    for (int i = 0; i < ayahs.length; i++) {
      final a = ayahs[i];
      final surahN = a['surah']?['englishName'] as String? ?? '';
      final surahAr = a['surah']?['name'] as String? ?? '';
      final ayahNum = a['numberInSurah'] as int? ?? 0;
      final text = a['text'] as String? ?? '';

      // Sure başlığı
      if (surahAr != currentSurahName) {
        currentSurahName = surahAr;
        widgets.add(_surahHeader(surahAr, surahN, ayahNum == 1, gold, isDark));
      }

      widgets.add(Text.rich(
        TextSpan(children: [
          TextSpan(
            text: text,
            style: GoogleFonts.notoNaskhArabic(
                fontSize: _fontSize,
                height: 2.0,
                color:
                    isDark ? const Color(0xFFE8DCC8) : const Color(0xFF1A1208)),
          ),
          WidgetSpan(
            alignment: PlaceholderAlignment.middle,
            child: _ayahNumber(ayahNum, gold, isDark),
          ),
        ]),
        textAlign: TextAlign.justify,
        textDirection: TextDirection.rtl,
      ));
    }

    return Container(
      color: bg,
      child: SingleChildScrollView(
        padding: const EdgeInsets.fromLTRB(18, 90, 18, 80),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            // Sayfa numarası (üstte ortada)
            Center(
              child: Container(
                margin: const EdgeInsets.only(bottom: 12),
                padding:
                    const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
                decoration: BoxDecoration(
                    color: gold.withOpacity(0.1),
                    borderRadius: BorderRadius.circular(6),
                    border: Border.all(color: gold.withOpacity(0.25))),
                child: Text('صفحة $page',
                    style: GoogleFonts.notoNaskhArabic(
                        fontSize: 12, color: gold, fontWeight: FontWeight.w600),
                    textDirection: TextDirection.rtl),
              ),
            ),
            ...widgets,
          ],
        ),
      ),
    );
  }

  Widget _surahHeader(String arabic, String english, bool showBasmala,
