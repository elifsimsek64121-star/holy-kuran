class AudioTab extends StatefulWidget {
  final List<SurahMeta> surahs;
  const AudioTab({super.key, required this.surahs});
  @override
  State<AudioTab> createState() => _AudioTabState();
}

class _AudioTabState extends State<AudioTab> with TickerProviderStateMixin {
  final AudioPlayer _player = AudioPlayer();
  int? _playingSurah;
  bool _isPlaying = false;
  bool _isLoading = false;
  Duration _position = Duration.zero;
  Duration _duration = Duration.zero;
  double _playbackSpeed = 1.0;
  String _reciter = 'ar.alafasy';
  final _search = TextEditingController();
  List<SurahMeta> _filtered = [];
  late AnimationController _waveCtrl;

  static const Map<String, String> kReciterAudioIds = {
    'ar.alafasy': 'Alafasy_128kbps',
    'ar.maher': 'MaherAlMuaiqly128kbps',
    'ar.minshawi': 'Minshawy_Murattal_128kbps',
    'ar.husary': 'Husary_128kbps',
    'ar.abdulbasit': 'AbdulSamad_128kbps',
    'ar.ghamadi': 'Ghamadi_40kbps',
  };

  @override
  void initState() {
    super.initState();
    _filtered = widget.surahs;
    _search.addListener(_onSearch);
    _waveCtrl = AnimationController(
        vsync: this, duration: const Duration(milliseconds: 800));

    _player.playerStateStream.listen((state) {
      if (mounted) {
        setState(() {
          _isPlaying = state.playing;
          _isLoading = state.processingState == ProcessingState.loading ||
              state.processingState == ProcessingState.buffering;
        });
        if (state.playing)
          _waveCtrl.repeat(reverse: true);
        else
          _waveCtrl.stop();
      }
    });

    _player.positionStream.listen((pos) {
      if (mounted) setState(() => _position = pos);
    });

    _player.durationStream.listen((dur) {
      if (mounted && dur != null) setState(() => _duration = dur);
    });

    _player.processingStateStream.listen((ps) {
      if (ps == ProcessingState.completed && mounted) {
        setState(() {
          _isPlaying = false;
          _position = Duration.zero;
        });
        _waveCtrl.stop();
      }
    });

    _loadReciter();
  }

  Future<void> _loadReciter() async {
    final p = await SharedPreferences.getInstance();
    if (mounted)
      setState(() => _reciter = p.getString('reciter') ?? 'ar.alafasy');
  }

  void _onSearch() {
    final q = _search.text.toLowerCase();
    setState(() {
      _filtered = q.isEmpty
          ? widget.surahs
          : widget.surahs
              .where((s) =>
                  s.englishName.toLowerCase().contains(q) ||
                  s.name.contains(_search.text) ||
                  s.number.toString() == q)
              .toList();
    });
  }

  String _surahAudioUrl(int surahNum) {
    final audioId = kReciterAudioIds[_reciter] ?? 'Alafasy_128kbps';
    final s = surahNum.toString().padLeft(3, '0');
    return 'https://download.quranicaudio.com/quran/$audioId/$s.mp3';
  }

  Future<void> _playSurah(int surahNum) async {
    if (_playingSurah == surahNum && _isPlaying) {
      await _player.pause();
      return;
    }
    if (_playingSurah == surahNum && !_isPlaying) {
      await _player.play();
      return;
    }
    setState(() {
      _playingSurah = surahNum;
      _isLoading = true;
      _position = Duration.zero;
    });
    try {
      await _player.setUrl(_surahAudioUrl(surahNum));
      await _player.setSpeed(_playbackSpeed);
      await _player.play();
    } catch (e) {
      if (mounted) {
        setState(() {
          _isLoading = false;
          _playingSurah = null;
        });
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(
            content: Text('Ses yüklenemedi: $e'), backgroundColor: Colors.red));
      }
    }
  }

  String _fmtDur(Duration d) {
    final m = d.inMinutes.remainder(60).toString().padLeft(2, '0');
    final s = d.inSeconds.remainder(60).toString().padLeft(2, '0');
    return '${d.inHours > 0 ? '${d.inHours}:' : ''}$m:$s';
  }

  @override
  void dispose() {
    _player.dispose();
    _waveCtrl.dispose();
    _search.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final isDark = Theme.of(context).brightness == Brightness.dark;

    return Column(children: [
      // ── Mini Player (çalan varsa) ──
      if (_playingSurah != null) _buildMiniPlayer(gold, isDark),

      // ── Arama ──
      Padding(
        padding: const EdgeInsets.fromLTRB(12, 10, 12, 4),
        child: TextField(
          controller: _search,
          decoration: InputDecoration(
            hintText: 'Sure ara...',
            prefixIcon: const Icon(Icons.search, size: 20),
            filled: true,
            contentPadding:
                const EdgeInsets.symmetric(vertical: 10, horizontal: 14),
            border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(12),
                borderSide: BorderSide.none),
          ),
        ),
      ),

      // ── Sure listesi ──
      Expanded(
        child: widget.surahs.isEmpty
            ? _loadingCenter()
            : ListView.builder(
                padding: const EdgeInsets.fromLTRB(12, 4, 12, 12),
                itemCount: _filtered.length,
                itemBuilder: (ctx, i) =>
                    _buildSurahRow(_filtered[i], gold, isDark),
              ),
      ),
    ]);
  }

  Widget _buildMiniPlayer(Color gold, bool isDark) {
    final surah = widget.surahs.firstWhere((s) => s.number == _playingSurah,
        orElse: () => widget.surahs.isNotEmpty
            ? widget.surahs.first
            : SurahMeta(
                number: 0,
                name: '',
                englishName: '',
                englishMeaning: '',
                ayahCount: 0,
                isMeccan: true));
    final progress = _duration.inSeconds > 0
        ? (_position.inSeconds / _duration.inSeconds).clamp(0.0, 1.0)
        : 0.0;

    return Container(
      margin: const EdgeInsets.fromLTRB(12, 8, 12, 0),
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        gradient: LinearGradient(
            colors: [gold.withOpacity(0.9), gold.withOpacity(0.5)],
            begin: Alignment.topLeft,
            end: Alignment.bottomRight),
        borderRadius: BorderRadius.circular(16),
        boxShadow: [
          BoxShadow(
              color: gold.withOpacity(0.3),
              blurRadius: 12,
              offset: const Offset(0, 4))
        ],
      ),
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(children: [
          // Dalga animasyonu
          AnimatedBuilder(
            animation: _waveCtrl,
            builder: (ctx, _) => Row(
              mainAxisSize: MainAxisSize.min,
              children: List.generate(4, (i) {
                final h = _isPlaying
                    ? (8 + 14 * math.sin(_waveCtrl.value * math.pi + i * 0.8))
                        .abs()
                    : 4.0;
                return Container(
                  width: 3,
                  height: h,
                  margin: const EdgeInsets.symmetric(horizontal: 1.5),
                  decoration: BoxDecoration(
                      color: Colors.black.withOpacity(0.7),
                      borderRadius: BorderRadius.circular(2)),
                );
              }),
            ),
          ),
          const SizedBox(width: 10),
          Expanded(
            child:
                Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text(surah.englishName,
                  style: const TextStyle(
                      fontSize: 14,
                      fontWeight: FontWeight.w800,
                      color: Colors.black87)),
              Text(surah.name,
                  style: GoogleFonts.notoNaskhArabic(
                      fontSize: 14, color: Colors.black54),
                  textDirection: TextDirection.rtl),
            ]),
          ),
          // Oynatma kontrolleri
          Row(mainAxisSize: MainAxisSize.min, children: [
            // Geri 10s
            GestureDetector(
              onTap: () => _player.seek(Duration(
                  seconds: (_position.inSeconds - 10)
                      .clamp(0, _duration.inSeconds))),
              child: Container(
                width: 34,
                height: 34,
                decoration: BoxDecoration(
                    color: Colors.black.withOpacity(0.1),
                    shape: BoxShape.circle),
                child: const Icon(Icons.replay_10,
                    color: Colors.black87, size: 18),
              ),
            ),
            const SizedBox(width: 8),
            // Oynat/Durdur
            GestureDetector(
              onTap: () => _playSurah(_playingSurah!),
              child: Container(
                width: 42,
                height: 42,
                decoration: const BoxDecoration(
                    color: Colors.black87, shape: BoxShape.circle),
                child: _isLoading
                    ? const Padding(
                        padding: EdgeInsets.all(10),
                        child: CircularProgressIndicator(
                            color: Colors.white, strokeWidth: 2))
                    : Icon(_isPlaying ? Icons.pause : Icons.play_arrow,
                        color: Colors.white, size: 22),
              ),
            ),
            const SizedBox(width: 8),
            // İleri 10s
            GestureDetector(
              onTap: () => _player.seek(Duration(
                  seconds: (_position.inSeconds + 10)
                      .clamp(0, _duration.inSeconds))),
              child: Container(
                width: 34,
                height: 34,
                decoration: BoxDecoration(
                    color: Colors.black.withOpacity(0.1),
                    shape: BoxShape.circle),
                child: const Icon(Icons.forward_10,
                    color: Colors.black87, size: 18),
              ),
            ),
            const SizedBox(width: 8),
            // Hız
            GestureDetector(
              onTap: () {
                final speeds = [0.75, 1.0, 1.25, 1.5, 2.0];
                final idx = speeds.indexOf(_playbackSpeed);
                final next = speeds[(idx + 1) % speeds.length];
                setState(() => _playbackSpeed = next);
                _player.setSpeed(next);
              },
              child: Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                    color: Colors.black.withOpacity(0.1),
                    borderRadius: BorderRadius.circular(8)),
                child: Text('${_playbackSpeed}x',
                    style: const TextStyle(
                        fontSize: 11,
                        fontWeight: FontWeight.w800,
                        color: Colors.black87)),
              ),
            ),
          ]),
        ]),
        const SizedBox(height: 10),
        // Progress bar
        Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
          SliderTheme(
            data: SliderTheme.of(context).copyWith(
              activeTrackColor: Colors.black87,
              inactiveTrackColor: Colors.black26,
              thumbColor: Colors.black87,
              overlayColor: Colors.black12,
              trackHeight: 3,
              thumbShape: const RoundSliderThumbShape(enabledThumbRadius: 6),
            ),
            child: Slider(
              value: progress,
              onChanged: (v) => _player
                  .seek(Duration(seconds: (v * _duration.inSeconds).round())),
            ),
          ),
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 4),
            child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(_fmtDur(_position),
                      style:
                          const TextStyle(fontSize: 10, color: Colors.black54)),
                  Text(_fmtDur(_duration),
                      style:
                          const TextStyle(fontSize: 10, color: Colors.black54)),
                ]),
          ),
        ]),
      ]),
    );
  }

