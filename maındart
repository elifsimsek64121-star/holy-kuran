// ─────────────────────────────────────────────
class QuranScreen extends StatefulWidget {
  final String reciter;
  final String translation;
  const QuranScreen(
      {super.key, required this.reciter, required this.translation});

  @override
  State<QuranScreen> createState() => _QuranScreenState();
}

class _QuranScreenState extends State<QuranScreen>
    with SingleTickerProviderStateMixin {
  late TabController _tab;
  List<SurahMeta> _surahs = [];
  List<SurahMeta> _filtered = [];
  bool _loading = true;
  String _error = '';
  final _search = TextEditingController();
  int? _lastSurah;
  int _lastAyah = 0;

  @override
  void initState() {
    super.initState();
    _tab = TabController(length: 4, vsync: this);
    _search.addListener(() => _filter(_search.text));
    _loadMeta();
    _loadLastPos();
  }

  Future<void> _loadMeta() async {
    try {
      final r = await http
          .get(Uri.parse('https://api.alquran.cloud/v1/meta'))
          .timeout(const Duration(seconds: 15));
      if (r.statusCode == 200) {
        final data = jsonDecode(r.body);
        final refs = (data['data']['surahs']['references'] as List);
        final list = refs
            .map((e) => SurahMeta.fromJson(Map<String, dynamic>.from(e)))
            .toList();
        if (mounted) {
          setState(() {
            _surahs = list;
            _filtered = list;
            _loading = false;
          });
        }
      } else {
        throw Exception('HTTP ${r.statusCode}');
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          _loading = false;
          _error = e.toString();
        });
      }
    }
  }

  Future<void> _loadLastPos() async {
    final p = await SharedPreferences.getInstance();
    _lastSurah = p.getInt('last_surah');
    _lastAyah = p.getInt('last_ayah') ?? 0;
    if (mounted) setState(() {});
  }

  void _filter(String q) {
    if (q.isEmpty) {
      setState(() => _filtered = _surahs);
      return;
    }
    final lq = q.toLowerCase();
