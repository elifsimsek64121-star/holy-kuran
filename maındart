final FlutterLocalNotificationsPlugin flutterLocalNotificationsPlugin =
    FlutterLocalNotificationsPlugin();

class NotificationService {
  static final NotificationService _i = NotificationService._();
  factory NotificationService() => _i;
  NotificationService._();

  static const String _channelId = 'prayer_times_channel';
  static const String _channelName = 'Namaz Vakitleri';
  static const String _channelDesc = 'Namaz vakti bildirimleri ve ezan sesi';

  Future<void> initialize() async {
    tz.initializeTimeZones();

    const androidSettings =
        AndroidInitializationSettings('@mipmap/ic_launcher');
    const iosSettings = DarwinInitializationSettings(
      requestAlertPermission: true,
      requestBadgePermission: true,
      requestSoundPermission: true,
    );

    await flutterLocalNotificationsPlugin.initialize(
      const InitializationSettings(android: androidSettings, iOS: iosSettings),
      onDidReceiveNotificationResponse: (_) {},
    );

    await _createChannel();
  }

  Future<void> _createChannel() async {
    const channel = AndroidNotificationChannel(
      _channelId,
      _channelName,
      description: _channelDesc,
      importance: Importance.max,
      playSound: true,
      sound: RawResourceAndroidNotificationSound('adhan'),
      enableVibration: true,
    );

    final androidImpl =
        flutterLocalNotificationsPlugin.resolvePlatformSpecificImplementation<
            AndroidFlutterLocalNotificationsPlugin>();

    await androidImpl?.createNotificationChannel(channel);
  }

  Future<void> requestPermissions() async {
    // iOS
    final iosImpl =
        flutterLocalNotificationsPlugin.resolvePlatformSpecificImplementation<
            IOSFlutterLocalNotificationsPlugin>();

    await iosImpl?.requestPermissions(
      alert: true,
      badge: true,
      sound: true,
    );

    // Android
    final androidImpl =
        flutterLocalNotificationsPlugin.resolvePlatformSpecificImplementation<
            AndroidFlutterLocalNotificationsPlugin>();

    await androidImpl?.requestNotificationsPermission();
  }

  Future<void> schedulePrayerNotifications({
    required Map<String, String> times,
    required String cityName,
    required bool adhanEnabled,
    required bool notificationsEnabled,
  }) async {
    if (!notificationsEnabled) {
      await cancelAll();
      return;
    }

    await cancelAll();

    final now = DateTime.now();
    int id = 100;

    for (final prayer in kMainPrayerKeys) {
      final t = times[prayer];
      if (t == null) continue;

      final parts = t.split(':');
      if (parts.length < 2) continue;

      final h = int.tryParse(parts[0]) ?? 0;
      final m = int.tryParse(parts[1]) ?? 0;

      var dt = DateTime(now.year, now.month, now.day, h, m);
      if (dt.isBefore(now)) {
        dt = dt.add(const Duration(days: 1));
      }

      final tzDt = tz.TZDateTime.from(dt, tz.local);

      final androidDetails = AndroidNotificationDetails(
        _channelId,
        _channelName,
        channelDescription: _channelDesc,
        importance: Importance.max,
        priority: Priority.high,
        playSound: adhanEnabled,
        sound: adhanEnabled
            ? const RawResourceAndroidNotificationSound('adhan')
            : null,
        enableVibration: true,
        styleInformation: BigTextStyleInformation(
          _msg(prayer),
          contentTitle: _title(prayer),
          summaryText: cityName,
        ),
        icon: '@mipmap/ic_launcher',
        color: const Color(0xFFC9A84C),
      );

      const iosDetails = DarwinNotificationDetails(
        presentAlert: true,
        presentBadge: true,
        presentSound: true,
        sound: 'adhan.aiff',
      );

      try {
        await flutterLocalNotificationsPlugin.zonedSchedule(
          id++,
          _title(prayer),
          _msg(prayer),
          tzDt,
          NotificationDetails(android: androidDetails, iOS: iosDetails),
          androidScheduleMode: AndroidScheduleMode.exactAllowWhileIdle,
          matchDateTimeComponents: DateTimeComponents.time,
          uiLocalNotificationDateInterpretation:
              UILocalNotificationDateInterpretation.absoluteTime,
        );
      } catch (_) {}
    }
  }

  Future<void> cancelAll() async {
    for (int i = 100; i < 110; i++) {
      await flutterLocalNotificationsPlugin.cancel(i);
    }
  }

  String _title(String p) {
    const titles = {
      'Fajr': '🌅 Sabah Namazı Vakti',
      'Dhuhr': '☀️ Öğle Namazı Vakti',
      'Asr': '🌤️ İkindi Namazı Vakti',
      'Maghrib': '🌅 Akşam Namazı Vakti',
      'Isha': '🌙 Yatsı Namazı Vakti',
    };
    return titles[p] ?? '$p Vakti';
  }

  String _msg(String p) {
    const messages = {
      'Fajr': 'Sabah namazı vakti girdi. Allah kabul etsin. 🤲',
      'Dhuhr': 'Öğle namazı vakti girdi. Hayırlı namazlar. 🤲',
      'Asr': 'İkindi namazı vakti girdi. Hayırlı namazlar. 🤲',
      'Maghrib': 'Akşam namazı vakti girdi. Hayırlı namazlar. 🤲',
      'Isha': 'Yatsı namazı vakti girdi. Hayırlı namazlar. 🤲',
    };
    return messages[p] ?? 'Namaz vakti girdi.';
  }

  Future<void> showVerseNotification(String verse, String ref) async {
    final androidDetails = AndroidNotificationDetails(
      'daily_verse_channel',
      'Günlük Ayet',
      channelDescription: 'Her gün yeni bir ayet',
      importance: Importance.defaultImportance,
      priority: Priority.defaultPriority,
      styleInformation: BigTextStyleInformation(verse),
    );

    await flutterLocalNotificationsPlugin.show(
      200,
      '📖 Günün Ayeti — $ref',
      verse,
      NotificationDetails(android: androidDetails),
    );
  }
}

