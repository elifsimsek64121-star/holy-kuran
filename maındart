class QiblaScreen extends StatefulWidget {
  const QiblaScreen({super.key});

  @override
  State<QiblaScreen> createState() => _QiblaScreenState();
}

class _QiblaScreenState extends State<QiblaScreen>
    with TickerProviderStateMixin {
  double _qiblaAngle = 0;
  double _compassHeading = 0;
  bool _hasLocation = false;
  bool _aligned = false;
  String _error = '';
  String _locationName = '';
  double _distanceKm = 0;
  StreamSubscription<CompassEvent>? _compassSub;
  late AnimationController _pulseCtrl;
  late AnimationController _rotateCtrl;
  late AnimationController _alignCtrl;
  double _targetAngle = 0;
  double _displayAngle = 0;
  List<double> _headingHistory = [];

  @override
  void initState() {
    super.initState();
    _pulseCtrl =
        AnimationController(vsync: this, duration: const Duration(seconds: 2))
          ..repeat(reverse: true);
    _rotateCtrl = AnimationController(
        vsync: this, duration: const Duration(milliseconds: 300));
    _alignCtrl =
        AnimationController(vsync: this, duration: const Duration(seconds: 1))
          ..repeat(reverse: true);
    _initQibla();
  }

  Future<void> _initQibla() async {
    try {
      var perm = await Geolocator.checkPermission();
      if (perm == LocationPermission.denied) {
        perm = await Geolocator.requestPermission();
      }
      if (perm == LocationPermission.denied ||
          perm == LocationPermission.deniedForever) {
        setState(() => _error = L.locationPermDenied);
        return;
      }

      final pos = await Geolocator.getCurrentPosition(
          desiredAccuracy: LocationAccuracy.medium);

      final q = _haversineQibla(pos.latitude, pos.longitude);
      final dist = Geolocator.distanceBetween(
              pos.latitude, pos.longitude, kKaabaLat, kKaabaLon) /
          1000;

      try {
        final places =
            await placemarkFromCoordinates(pos.latitude, pos.longitude);
        if (places.isNotEmpty) {
          _locationName =
              '${places.first.locality ?? ''}, ${places.first.country ?? ''}';
        }
      } catch (_) {}

      if (mounted) {
        setState(() {
          _qiblaAngle = q;
          _distanceKm = dist;
          _hasLocation = true;
        });
      }

      _compassSub = FlutterCompass.events?.listen((event) {
        if (event.heading == null) return;

        // Smooth filtering
        _headingHistory.add(event.heading!);
        if (_headingHistory.length > 5) _headingHistory.removeAt(0);
        double smoothed =
            _headingHistory.reduce((a, b) => a + b) / _headingHistory.length;

        if (mounted) {
          final diff = (_qiblaAngle - smoothed).abs() % 360;
          setState(() {
            _compassHeading = smoothed;
            _displayAngle = (_qiblaAngle - smoothed) * math.pi / 180;
            _aligned = diff < 5 || diff > 355;
          });
        }
      });
    } catch (e) {
      if (mounted) setState(() => _error = e.toString());
    }
  }

  double _haversineQibla(double lat, double lon) {
    final lat1 = lat * math.pi / 180;
    final lat2 = kKaabaLat * math.pi / 180;
    final dLon = (kKaabaLon - lon) * math.pi / 180;
    final y = math.sin(dLon) * math.cos(lat2);
    final x = math.cos(lat1) * math.sin(lat2) -
        math.sin(lat1) * math.cos(lat2) * math.cos(dLon);
    double bearing = math.atan2(y, x) * 180 / math.pi;
    return (bearing + 360) % 360;
  }

  @override
  void dispose() {
    _compassSub?.cancel();
    _pulseCtrl.dispose();
    _rotateCtrl.dispose();
    _alignCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final teal = Theme.of(context).colorScheme.secondary;
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final activeColor = _aligned ? teal : gold;

    if (_error.isNotEmpty) {
      return Scaffold(
        appBar: AppBar(title: Text(L.qiblaFinder)),
        body: Center(
          child: Padding(
            padding: const EdgeInsets.all(24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(Icons.location_off, size: 56, color: Colors.red),
                const SizedBox(height: 16),
                Text(_error,
                    textAlign: TextAlign.center,
                    style: const TextStyle(color: Colors.red, fontSize: 14)),
                const SizedBox(height: 20),
                ElevatedButton.icon(
                  onPressed: () {
                    setState(() => _error = '');
                    _initQibla();
                  },
                  icon: const Icon(Icons.refresh),
                  label: const Text('Tekrar Dene'),
                ),
              ],
            ),
          ),
        ),
      );
    }

    if (!_hasLocation) {
      return Scaffold(
        appBar: AppBar(title: Text(L.qiblaFinder)),
        body: Center(
          child: Column(
            mainAxisSize: MainAxisSize.min,
