class ZikirScreen extends StatefulWidget {
  const ZikirScreen({super.key});

  @override
  State<ZikirScreen> createState() => _ZikirScreenState();
}

class _ZikirScreenState extends State<ZikirScreen>
    with SingleTickerProviderStateMixin {
  int _count = 0;
  int _target = 33;
  String _currentKey = 'subhanallah';
  List<Map<String, dynamic>> _history = [];
  late AnimationController _bounce;
  late Animation<double> _scale;
  bool _targetReachedThisSession = false;

  @override
  void initState() {
    super.initState();
    _bounce = AnimationController(
        vsync: this, duration: const Duration(milliseconds: 100));
    _scale = Tween(begin: 1.0, end: 0.92)
        .animate(CurvedAnimation(parent: _bounce, curve: Curves.easeInOut));
    _load();
  }

  @override
  void dispose() {
    _bounce.dispose();
    super.dispose();
  }

  Future<void> _load() async {
    final p = await SharedPreferences.getInstance();
    final cnt = p.getInt('zikir_count_$_currentKey') ?? 0;
    final hist = p.getStringList('zikir_history') ?? [];
    setState(() {
      _count = cnt;
      _targetReachedThisSession = false;
      _history = hist.map((e) {
        final parts = e.split('|');
        return {
          'name': parts.elementAtOrNull(0) ?? '',
          'count': int.tryParse(parts.elementAtOrNull(1) ?? '0') ?? 0,
          'date': parts.elementAtOrNull(2) ?? '',
        };
      }).toList();
    });
  }

  Future<void> _save() async {
    final p = await SharedPreferences.getInstance();
    await p.setInt('zikir_count_$_currentKey', _count);
  }

  Future<void> _increment() async {
    setState(() => _count++);
    _bounce.forward().then((_) => _bounce.reverse());
    try {
      final hasVib = await Vibration.hasVibrator() ?? false;
      if (hasVib) Vibration.vibrate(duration: 30, amplitude: 60);
    } catch (_) {}
    await _save();
    if (_target > 0 && _count == _target && !_targetReachedThisSession) {
      _targetReachedThisSession = true;
      if (mounted) _showTargetReachedDialog();
    }
  }

  void _showTargetReachedDialog() {
    final gold = Theme.of(context).colorScheme.primary;
    final teal = Theme.of(context).colorScheme.secondary;
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
        title: Row(
          children: [
            const Text('🎉 ', style: TextStyle(fontSize: 24)),
            Text(
              L.lang == AppLang.en ? 'Target Reached!' : 'Hedefe Ulaştınız!',
              style: TextStyle(
                  color: gold, fontSize: 18, fontWeight: FontWeight.w700),
            ),
          ],
        ),
        content: Text(
          L.lang == AppLang.en
              ? 'MashaAllah! Would you like to watch a short video to support us?'
              : 'Maşallah! Bizi desteklemek için kısa bir video izlemek ister misiniz?',
          style: const TextStyle(fontSize: 14, height: 1.6),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: Text(
              L.lang == AppLang.en ? 'No thanks' : 'Hayır',
              style: TextStyle(color: Colors.grey.shade500),
            ),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: gold,
              foregroundColor: const Color(0xFF0D1117),
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(12)),
            ),
            onPressed: () {
              Navigator.pop(ctx);
              AdManager().showRewarded(
                onRewarded: () {
                  if (mounted) {
                    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
                      content: Text(L.lang == AppLang.en
                          ? 'JazakAllah Khair! Thank you!'
                          : 'Cezakellah! Desteğin için teşekkürler!'),
                      backgroundColor: teal,
                    ));
                  }
                },
              );
            },
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(Icons.play_circle_outline, size: 16),
                const SizedBox(width: 6),
                Text(L.lang == AppLang.en ? 'Watch Video' : 'Video İzle'),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Future<void> _reset() async {
    setState(() {
      _count = 0;
      _targetReachedThisSession = false;
    });
    await _save();
  }

  Future<void> _saveToHistory() async {
    if (_count == 0) return;
    final p = await SharedPreferences.getInstance();
    final d = kZikirList[_currentKey]!;
    final name = L.lang == AppLang.en ? d['en']! : d['tr']!;
    final entry =
        '$name|$_count|${DateTime.now().toLocal().toString().substring(0, 10)}';
    final hist = p.getStringList('zikir_history') ?? [];
    hist.insert(0, entry);
    if (hist.length > 20) hist.removeLast();
    await p.setStringList('zikir_history', hist);
    await _reset();
    await _load();
  }

