class MushafTab extends StatefulWidget {
  final String reciter;
  const MushafTab({super.key, required this.reciter});

  @override
  State<MushafTab> createState() => _MushafTabState();
}

class _MushafTabState extends State<MushafTab> {
  int _page = 1;
  static const int _totalPages = 604;
  List<Map<String, dynamic>> _verses = [];
  bool _loading = false;
  String _error = '';
  final _scrollCtrl = ScrollController();
  final _player = AudioPlayer();
  int _playingIdx = -1;
  bool _isPlaying = false;
  double _fontSize = 22.0;
  int _currentJuz = 1;
  int _currentSurah = 1;
  String _currentSurahName = 'Al-Fatihah';

  @override
  void initState() {
    super.initState();
    _loadPage(_page);
    _player.playerStateStream.listen((s) {
      if (mounted) setState(() => _isPlaying = s.playing);
    });
    _player.processingStateStream.listen((ps) {
      if (ps == ProcessingState.completed) {
        final next = _playingIdx + 1;
        if (next < _verses.length) _playVerse(next);
      }
    });
  }

  Future<void> _loadPage(int page) async {
    if (mounted) {
      setState(() {
        _loading = true;
        _error = '';
        _verses = [];
      });
    }
    try {
      final url =
          'https://api.quran.com/api/v4/verses/by_page/$page?mushaf_id=3&fields=text_uthmani,verse_key,juz_number,chapter_id&per_page=50';
      final r =
          await http.get(Uri.parse(url)).timeout(const Duration(seconds: 20));
      if (r.statusCode != 200) throw Exception('HTTP ${r.statusCode}');
      final data = jsonDecode(r.body);
      final vs = data['verses'] as List;

      if (mounted) {
        // Cüz ve sure bilgisini çıkar
        int juzNum = 1;
        int surahNum = 1;
        String surahName = '';

        if (vs.isNotEmpty) {
          juzNum = vs.first['juz_number'] as int? ?? 1;
          surahNum = vs.first['chapter_id'] as int? ?? 1;
          final key = vs.first['verse_key'] as String? ?? '1:1';
          // Sure adını verse_key'den çıkaramayız, API'den gelmiyor
          // Cüz datasından çıkaralım
          final matchingJuz = kJuzData.firstWhere(
            (j) => j['juz'] == juzNum,
            orElse: () => kJuzData.first,
          );
          surahName = '';
        }

        setState(() {
          _verses = vs
              .map((v) => {
                    'text': v['text_uthmani'] as String? ?? '',
                    'key': v['verse_key'] as String? ?? '',
                    'juz': v['juz_number'] ?? 1,
                    'surah': v['chapter_id'] ?? 1,
                  })
              .toList();
          _loading = false;
          _page = page;
          _playingIdx = -1;
          _currentJuz = juzNum;
          _currentSurah = surahNum;
        });
        _scrollCtrl.jumpTo(0);
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          _loading = false;
          _error = e.toString();
        });
      }
    }
  }

  Future<void> _playVerse(int idx) async {
    if (idx < 0 || idx >= _verses.length) return;
    if (_playingIdx == idx && _isPlaying) {
      await _player.pause();
      return;
    }
    setState(() => _playingIdx = idx);
    try {
      final key = _verses[idx]['key'] as String;
      final parts = key.split(':');
      final s = int.parse(parts[0]);
      final a = int.parse(parts[1]);
      await _player.setUrl(ayahAudioUrl(s, a));
      await _player.play();
    } catch (_) {}
  }

  // Cüze göre sayfaya git
  void _jumpToJuz(int juzNum) {
    // Cüz başlangıç sayfaları (yaklaşık)
    const juzPages = [
      1,
      22,
      42,
      62,
      82,
      102,
      121,
      142,
      162,
      182,
      201,
      222,
      241,
      261,
      282,
      302,
      322,
      342,
      362,
      382,
      402,
      422,
      442,
      462,
      482,
      502,
      522,
      542,
      562,
      582
    ];
    if (juzNum >= 1 && juzNum <= 30) {
      _loadPage(juzPages[juzNum - 1]);
    }
  }

  @override
  void dispose() {
    _player.dispose();
    _scrollCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final teal = Theme.of(context).colorScheme.secondary;
    final isDark = Theme.of(context).brightness == Brightness.dark;

    return Column(
      children: [
        // Üst kontrol paneli
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
          color: isDark ? const Color(0xFF161B22) : const Color(0xFFF5F1EB),
          child: Column(
            children: [
              // Sayfa navigasyon satırı
              Row(
                children: [
                  IconButton(
                    onPressed: _page > 1 ? () => _loadPage(_page - 1) : null,
                    icon: const Icon(Icons.chevron_left),
                    visualDensity: VisualDensity.compact,
                  ),
                  Expanded(
