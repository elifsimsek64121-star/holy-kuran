class _AudioTabState extends State<AudioTab> {
  final _player = AudioPlayer();
  int? _playingSurah;
  bool _isPlaying = false;
  String _currentReciter = 'afs'; // Alafasy folder on mp3quran.net

  static const Map<String, String> _reciters = {
    'afs': 'Mişari Raşid el-Afasî',
    'maher': 'Maher el-Muaykılî',
    'minshawi': 'Minsavî',
  };

  @override
  void initState() {
    super.initState();
    _player.playerStateStream.listen((s) {
      if (mounted) setState(() => _isPlaying = s.playing);
    });
  }

  Future<void> _play(int surahNumber) async {
    if (_playingSurah == surahNumber && _isPlaying) {
      await _player.pause();
      return;
    }
    setState(() => _playingSurah = surahNumber);
    try {
      final url = surahAudioUrl(surahNumber, folder: _currentReciter);
      await _player.setUrl(url);
      await _player.play();
    } catch (_) {}
  }

  @override
  void dispose() {
    _player.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    if (widget.surahs.isEmpty) return _loadingCenter();

    return Column(
      children: [
        // Reciter selector
        Padding(
          padding: const EdgeInsets.fromLTRB(12, 10, 12, 4),
          child: Row(
            children: [
              const Icon(Icons.record_voice_over, size: 18),
              const SizedBox(width: 8),
              Expanded(
                child: DropdownButton<String>(
                  value: _currentReciter,
                  isExpanded: true,
                  underline: const SizedBox(),
                  items: _reciters.entries
                      .map((e) =>
                          DropdownMenuItem(value: e.key, child: Text(e.value)))
                      .toList(),
                  onChanged: (v) {
                    if (v != null) {
                      setState(() => _currentReciter = v);
                      if (_playingSurah != null) _play(_playingSurah!);
                    }
                  },
                ),
              ),
            ],
          ),
        ),
        Expanded(
          child: ListView.builder(
            padding: const EdgeInsets.fromLTRB(12, 4, 12, 80),
            itemCount: widget.surahs.length,
            itemBuilder: (ctx, i) {
              final s = widget.surahs[i];
              final playing = _playingSurah == s.number;
              return Card(
                margin: const EdgeInsets.only(bottom: 6),
                child: ListTile(
                  leading: Container(
                    width: 38,
                    height: 38,
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      color: playing
                          ? gold.withOpacity(0.2)
                          : gold.withOpacity(0.1),
                      border: Border.all(
                          color: playing ? gold : gold.withOpacity(0.3)),
                    ),
                    child: Center(
                        child: Text('${s.number}',
                            style: TextStyle(
                                fontSize: 11,
                                fontWeight: FontWeight.w700,
                                color: gold))),
                  ),
                  title: Text(s.englishName,
                      style: const TextStyle(
                          fontSize: 14, fontWeight: FontWeight.w600)),
                  subtitle: Text(s.name,
                      style: GoogleFonts.notoNaskhArabic(
                          fontSize: 14,
                          color: Theme.of(ctx).colorScheme.primary),
                      textDirection: TextDirection.rtl),
                  trailing: Icon(
                      playing && _isPlaying
                          ? Icons.pause_circle
                          : Icons.play_circle,
                      color: gold,
                      size: 32),
                  onTap: () => _play(s.number),
                ),
              );
            },
          ),
        ),
      ],
    );
  }
}

