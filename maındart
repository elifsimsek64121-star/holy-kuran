class ZikirScreen extends StatefulWidget {
  const ZikirScreen({super.key});

  @override
  State<ZikirScreen> createState() => _ZikirScreenState();
}

class _ZikirScreenState extends State<ZikirScreen>
    with SingleTickerProviderStateMixin {
  int _count = 0;
  int _target = 33;
  String _currentKey = 'subhanallah';
  List<Map<String, dynamic>> _history = [];
  late AnimationController _bounce;
  late Animation<double> _scale;

  @override
  void initState() {
    super.initState();
    _bounce = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 100),
    );
    _scale = Tween(begin: 1.0, end: 0.92)
        .animate(CurvedAnimation(parent: _bounce, curve: Curves.easeInOut));
    _load();
  }

  @override
  void dispose() {
    _bounce.dispose();
    super.dispose();
  }

  Future<void> _load() async {
    final p = await SharedPreferences.getInstance();
    final cnt = p.getInt('zikir_count_$_currentKey') ?? 0;
    final hist = p.getStringList('zikir_history') ?? [];
    setState(() {
      _count = cnt;
      _history = hist.map((e) {
        final parts = e.split('|');
        return {
          'name': parts.elementAtOrNull(0) ?? '',
          'count': int.tryParse(parts.elementAtOrNull(1) ?? '0') ?? 0,
          'date': parts.elementAtOrNull(2) ?? '',
        };
      }).toList();
    });
  }

  Future<void> _save() async {
    final p = await SharedPreferences.getInstance();
    await p.setInt('zikir_count_$_currentKey', _count);
  }

  Future<void> _increment() async {
    setState(() => _count++);
    _bounce.forward().then((_) => _bounce.reverse());
    try {
      final hasVib = await Vibration.hasVibrator() ?? false;
      if (hasVib) Vibration.vibrate(duration: 30, amplitude: 60);
    } catch (_) {}
    await _save();
    if (_target > 0 && _count == _target) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(L.lang == AppLang.en
                ? 'Target reached! Masha\'Allah!'
                : 'Hedefe ulaştınız! Maşallah!'),
            backgroundColor: Theme.of(context).colorScheme.secondary,
          ),
        );
      }
    }
  }

  Future<void> _reset() async {
    setState(() => _count = 0);
    await _save();
  }

  Future<void> _saveToHistory() async {
    if (_count == 0) return;
    final p = await SharedPreferences.getInstance();
    final d = kZikirList[_currentKey]!;
    final name = L.lang == AppLang.en ? d['en']! : d['tr']!;
    final entry =
        '$name|$_count|${DateTime.now().toLocal().toString().substring(0, 10)}';
    final hist = p.getStringList('zikir_history') ?? [];
    hist.insert(0, entry);
    if (hist.length > 20) hist.removeLast();
    await p.setStringList('zikir_history', hist);
    await _reset();
    await _load();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final teal = Theme.of(context).colorScheme.secondary;
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final d = kZikirList[_currentKey]!;
    final progress = _target > 0 ? (_count / _target).clamp(0.0, 1.0) : 0.0;

    return Scaffold(
      appBar: AppBar(
        title: Text(L.dhikr),
        actions: [
          IconButton(
            icon: const Icon(Icons.history, size: 22),
            onPressed: () => showModalBottomSheet(
              context: context,
              builder: (_) => _ZikirHistory(history: _history),
            ),
          ),
        ],
      ),
      body: Column(
        children: [
          // Zikir selector
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
            child: SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              child: Row(
                children: kZikirList.entries.map((e) {
                  final active = e.key == _currentKey;
                  final label =
                      L.lang == AppLang.en ? e.value['en']! : e.value['tr']!;
                  return Padding(
                    padding: const EdgeInsets.only(right: 8),
                    child: ChoiceChip(
                      label: Text(label,
                          style: TextStyle(
                              fontSize: 12,
                              color: active ? const Color(0xFF0D1117) : null)),
                      selected: active,
                      selectedColor: gold,
                      onSelected: (_) async {
                        setState(() {
                          _currentKey = e.key;
                          _count = 0;
                        });
                        await _load();
                      },
                    ),
                  );
                }).toList(),
              ),
            ),
          ),
          Expanded(
            child: Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  // Arabic text
                  Text(
                    d['ar']!,
                    style: GoogleFonts.notoNaskhArabic(
                        fontSize: 28, color: gold, fontWeight: FontWeight.w700),
                    textDirection: TextDirection.rtl,
                  ),
                  const SizedBox(height: 4),
                  Text(
                    L.lang == AppLang.en ? d['en']! : d['tr']!,
                    style: TextStyle(
                        fontSize: 14,
                        color: isDark ? Colors.white54 : Colors.black45),
                  ),
                  const SizedBox(height: 32),
                  // Count
                  Text(
                    '$_count',
                    style: TextStyle(
                      fontSize: 96,
                      fontWeight: FontWeight.w700,
                      color: progress >= 1.0 ? teal : gold,
                      height: 1,
                    ),
                  ),
                  const SizedBox(height: 8),
                  // Progress
                  if (_target > 0) ...[
                    Padding(
                      padding: const EdgeInsets.symmetric(horizontal: 40),
                      child: ClipRRect(
                        borderRadius: BorderRadius.circular(4),
                        child: LinearProgressIndicator(
                          value: progress,
                          minHeight: 6,
                          backgroundColor: gold.withOpacity(0.15),
                          valueColor: AlwaysStoppedAnimation(
                              progress >= 1.0 ? teal : gold),
                        ),
                      ),
                    ),
                    const SizedBox(height: 6),
                    Text(
                      '$_count / $_target',
                      style: TextStyle(
                          fontSize: 13,
                          color: isDark ? Colors.white38 : Colors.black38),
                    ),
                  ],
                  const SizedBox(height: 32),
                  // Main tap button
                  ScaleTransition(
                    scale: _scale,
                    child: GestureDetector(
                      onTap: _increment,
                      child: Container(
                        width: 200,
                        height: 200,
                        decoration: BoxDecoration(
                          shape: BoxShape.circle,
                          color: isDark
                              ? const Color(0xFF161B22)
                              : const Color(0xFFFAF7F0),
                          border: Border.all(color: gold, width: 3),
                          boxShadow: [
                            BoxShadow(
                              color: gold.withOpacity(0.15),
                              blurRadius: 20,
                              spreadRadius: 4,
                            ),
                          ],
                        ),
                        child: Center(
                          child: Column(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              Icon(Icons.touch_app, size: 60, color: gold),
                              const SizedBox(height: 4),
                              Text(
                                L.lang == AppLang.en ? 'TAP' : 'TIKLA',
                                style: TextStyle(
                                    fontSize: 12,
                                    fontWeight: FontWeight.w700,
                                    color: gold,
                                    letterSpacing: 2),
                              ),
                            ],
                          ),
                        ),
                      ),
                    ),
                  ),
                  const SizedBox(height: 24),
                  // Controls
                  Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 24),
                    child: Row(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        // Target selector
                        DropdownButton<int>(
                          value: _target,
                          underline: const SizedBox(),
                          items: [33, 99, 100, 1000, 0]
                              .map((v) => DropdownMenuItem(
                                  value: v,
                                  child: Text(
                                      '${L.target}: ${v == 0 ? '∞' : v}',
                                      style: const TextStyle(fontSize: 13))))
                              .toList(),
                          onChanged: (v) => setState(() => _target = v ?? 33),
                        ),
                        const SizedBox(width: 12),
                        OutlinedButton.icon(
                          onPressed: _reset,
                          icon: const Icon(Icons.refresh, size: 16),
                          label: Text(L.reset,
                              style: const TextStyle(fontSize: 13)),
                        ),
                        const SizedBox(width: 8),
                        ElevatedButton.icon(
                          onPressed: _saveToHistory,
                          icon: const Icon(Icons.save, size: 16),
                          label: Text(L.save,
                              style: const TextStyle(fontSize: 13)),
                          style: ElevatedButton.styleFrom(
                              backgroundColor: gold,
                              foregroundColor: const Color(0xFF0D1117)),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

