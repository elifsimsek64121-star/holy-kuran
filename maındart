  @override
  State<AudioTab> createState() => _AudioTabState();
}

class _AudioTabState extends State<AudioTab> {
  final _player = AudioPlayer();
  int? _playingSurah;
  bool _isPlaying = false;
  bool _isLoading = false;
  String _currentReciter = 'afs';
  Duration _position = Duration.zero;
  Duration _duration = Duration.zero;

  static const Map<String, String> _reciters = {
    'afs': 'Mişari Raşid el-Afasî',
    'maher': 'Maher el-Muaykılî',
    'minshawi': 'Minsavî',
  };

  @override
  void initState() {
    super.initState();
    _player.playerStateStream.listen((s) {
      if (mounted) setState(() => _isPlaying = s.playing);
    });
    _player.positionStream.listen((p) {
      if (mounted) setState(() => _position = p);
    });
    _player.durationStream.listen((d) {
      if (mounted) setState(() => _duration = d ?? Duration.zero);
    });
    _player.processingStateStream.listen((ps) {
      if (mounted)
        setState(() => _isLoading =
            ps == ProcessingState.buffering || ps == ProcessingState.loading);
    });
  }

  Future<void> _play(int surahNumber) async {
    if (_playingSurah == surahNumber && _isPlaying) {
      await _player.pause();
      return;
    }
    if (_playingSurah == surahNumber && !_isPlaying) {
      await _player.play();
      return;
    }
    setState(() {
      _playingSurah = surahNumber;
      _isLoading = true;
    });
    try {
      final url = surahAudioUrl(surahNumber, folder: _currentReciter);
      await _player.setUrl(url);
      await _player.play();
    } catch (_) {
      setState(() => _isLoading = false);
    }
  }

  String _formatDur(Duration d) {
    final m = d.inMinutes.toString().padLeft(2, '0');
    final s = (d.inSeconds % 60).toString().padLeft(2, '0');
    return '$m:$s';
  }

  @override
  void dispose() {
    _player.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final gold = Theme.of(context).colorScheme.primary;
    final isDark = Theme.of(context).brightness == Brightness.dark;
    if (widget.surahs.isEmpty) return _loadingCenter();

    return Column(
      children: [
        // Kari seçimi
        Padding(
          padding: const EdgeInsets.fromLTRB(12, 10, 12, 4),
          child: Row(
            children: [
              const Icon(Icons.record_voice_over, size: 18),
              const SizedBox(width: 8),
              Expanded(
                child: DropdownButton<String>(
                  value: _currentReciter,
                  isExpanded: true,
                  underline: const SizedBox(),
                  items: _reciters.entries
                      .map((e) =>
                          DropdownMenuItem(value: e.key, child: Text(e.value)))
                      .toList(),
                  onChanged: (v) {
                    if (v != null) {
                      setState(() => _currentReciter = v);
                      if (_playingSurah != null) _play(_playingSurah!);
                    }
                  },
                ),
              ),
            ],
          ),
        ),

        // Çalınan sure mini player
        if (_playingSurah != null) ...[
          Container(
            margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              color: gold.withOpacity(0.1),
              borderRadius: BorderRadius.circular(14),
              border: Border.all(color: gold.withOpacity(0.3)),
            ),
            child: Column(
              children: [
                Row(
                  children: [
                    Container(
                      width: 36,
                      height: 36,
                      decoration:
                          BoxDecoration(shape: BoxShape.circle, color: gold),
                      child: Center(
                        child: _isLoading
                            ? const SizedBox(
                                width: 18,
                                height: 18,
                                child: CircularProgressIndicator(
                                    color: Colors.white, strokeWidth: 2))
                            : Icon(
                                _isPlaying ? Icons.pause : Icons.play_arrow,
                                color: const Color(0xFF0D1117),
                                size: 20,
                              ),
                      ),
                    ),
                    const SizedBox(width: 10),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            widget.surahs
                                .firstWhere((s) => s.number == _playingSurah!,
                                    orElse: () => widget.surahs.first)
                                .englishName,
                            style: const TextStyle(
                                fontSize: 14, fontWeight: FontWeight.w700),
                          ),
                          Text(
                            _reciters[_currentReciter] ?? '',
                            style: TextStyle(
                                fontSize: 11,
                                color:
                                    isDark ? Colors.white54 : Colors.black45),
                          ),
                        ],
                      ),
                    ),
                    Text(
                      '${_formatDur(_position)} / ${_formatDur(_duration)}',
                      style: TextStyle(fontSize: 11, color: gold),
                    ),
                  ],
                ),
                const SizedBox(height: 6),
                SliderTheme(
                  data: SliderTheme.of(context).copyWith(
                    trackHeight: 2,
