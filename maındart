// MP3 CDN: everyayah.com — 128kbps, reliable
String ayahAudioUrl(int surahNum, int ayahNum,
    {String reciter = 'Alafasy_128kbps'}) {
  final s = surahNum.toString().padLeft(3, '0');
  final a = ayahNum.toString().padLeft(3, '0');
  return 'https://everyayah.com/data/$reciter/$s$a.mp3';
}

// Full surah audio — mp3quran.net
String surahAudioUrl(int surahNum, {String folder = 'afs'}) {
  final s = surahNum.toString().padLeft(3, '0');
  return 'https://server8.mp3quran.net/$folder/$s.mp3';
}

