//  Pusula halka çizici
// ─────────────────────────────────────────────
class _CompassRingPainter extends CustomPainter {
  final double heading;
  final Color gold;
  final bool isDark;
  _CompassRingPainter(
      {required this.heading, required this.gold, required this.isDark});

  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);
    final radius = size.width / 2 - 4;
    final paint = Paint()
      ..color = gold.withOpacity(0.15)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.5;
    canvas.drawCircle(center, radius, paint);

    final tickPaint = Paint()
      ..strokeCap = StrokeCap.round
      ..strokeWidth = 1.5;

    for (int deg = 0; deg < 360; deg += 5) {
      final rad = (deg - heading) * math.pi / 180;
      final isMain = deg % 90 == 0;
      final isMed = deg % 45 == 0;
      final tickLen = isMain
          ? 14.0
          : isMed
              ? 10.0
              : 6.0;
      tickPaint.color = isMain ? gold.withOpacity(0.8) : gold.withOpacity(0.3);
      final outer = Offset(center.dx + radius * math.sin(rad),
          center.dy - radius * math.cos(rad));
      final inner = Offset(center.dx + (radius - tickLen) * math.sin(rad),
          center.dy - (radius - tickLen) * math.cos(rad));
      canvas.drawLine(outer, inner, tickPaint);
    }
  }

  @override
  bool shouldRepaint(_CompassRingPainter old) =>
      old.heading != heading || old.gold != gold;
}

