                    Expanded(
                      child: Text(
                        '${L.continueReading} — ${_surahs.firstWhere((x) => x.number == _lastSurah!, orElse: () => _surahs.first).englishName}, ${L.verse} $_lastAyah',
                        style: TextStyle(
                            color: gold,
                            fontSize: 13,
                            fontWeight: FontWeight.w600),
                      ),
                    ),
                    Icon(Icons.arrow_forward_ios, color: gold, size: 14),
                  ],
                ),
